---
import Layout from '~/layouts/PageLayout.astro';

import Header from '~/components/widgets/Header.astro';
import HeroIntro from '~/components/widgets/HeroIntro.astro';
import ExperienceList from '~/components/widgets/ExperienceList.astro';
import Projects from '~/components/widgets/Projects.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import Footer from '~/components/widgets/Footer.astro';

const metadata = {
  title: 'Arun Bagavathiannan — Software Engineer',
  ignoreTitleTemplate: true,
  description:
    'Computer Science student at UT Austin. Technical Lead on UT Registration Plus, a Chrome extension used by 60,000+ students.',
};
---

<Layout metadata={metadata}>
  <Fragment slot="announcement"></Fragment>

  <Fragment slot="header">
    <Header
      links={[
        { text: 'Experience', href: '#experience' },
        { text: 'Projects', href: '#projects' },
        { text: 'Contact', href: '#contact' },
      ]}
      isSticky
      showToggleTheme
    />
  </Fragment>

  <!-- Hero ************************** -->

  <HeroIntro
    id="about"
    name="Arun Bagavathiannan"
    resume={{ text: 'View Résumé', href: '/resume.pdf' }}
    socials={[
      { label: 'LinkedIn', href: 'https://linkedin.com/in/arun-bagavathiannan', icon: 'tabler:brand-linkedin' },
      { label: 'GitHub', href: 'https://github.com/arunbagavathiannan', icon: 'tabler:brand-github' },
      { label: 'Email', href: 'mailto:arun.bagavathiannan@gmail.com', icon: 'tabler:mail' },
      { label: 'YouTube', href: 'https://youtube.com', icon: 'tabler:brand-youtube' },
    ]}
  >
    <Fragment slot="intro">
      <p>
        I'm a Computer Science student at UT Austin. I lead a team of six on{' '}
        <a href="#projects">UT Registration Plus</a>, the Chrome extension{' '}
        <a href="#projects">60,000+ students</a>{' '}use to build their schedules. Before that I trained{' '}
        <a href="#projects">computer-vision models</a>{' '}for agricultural research at Texas A&amp;M, and I've spent
        five years growing a{' '}
        <a href="https://youtube.com" target="_blank" rel="noopener noreferrer">YouTube channel</a>{' '}past 20,000
        subscribers.
      </p>
      <p>
        Different surfaces, same instinct: I like building things that get used, then measuring whether they actually
        worked.
      </p>
    </Fragment>
  </HeroIntro>

  <!-- Experience ******************** -->

  <ExperienceList
    id="experience"
    title="Experience"
    classes={{ headline: { container: 'max-w-none text-left md:mx-0', title: 'text-3xl md:text-4xl' } }}
    items={[
      {
        organization: 'Longhorn Developers',
        href: 'https://github.com/Longhorn-Developers',
        role: 'Technical Lead, UT Registration Plus',
        location: 'Austin, TX',
        dates: 'Aug 2026 — Present',
        icon: 'tabler:code',
        description:
          'Promoted from Software Engineer to lead a team of 6. Ran end-to-end hiring for the developer fellowship — screened 80+ applications, interviewed finalists, selected 5 engineers at roughly a 6% acceptance rate.',
      },
      {
        organization: 'Longhorn Developers',
        href: 'https://github.com/Longhorn-Developers',
        role: 'Software Engineer, UT Registration Plus',
        location: 'Austin, TX',
        dates: 'Jan 2026 — Aug 2026',
        icon: 'tabler:brand-chrome',
        description:
          'Built the Course Status Checker for real-time seat tracking inside the calendar UI, cited in UT CS News coverage of the extension. Designed a throttled refresh system in React and TypeScript to avoid API rate-limiting under university infrastructure constraints, and a reactive store synchronising state between background service workers and the frontend.',
      },
      {
        organization: 'Texas A&M University',
        role: 'ML Research Intern',
        location: 'College Station, TX',
        dates: 'Jan 2025 — Mar 2025',
        icon: 'tabler:microscope',
        description:
          'Took a raw 100-image dataset to a production YOLOv8 detection model at 80%+ precision and recall. Automated augmentation workflows in Python and OpenCV scaled training data 6×. Presented results at 3 conferences, including the Weed Science Society of America in Vancouver and the European Weed Research Society in Spain.',
      },
      {
        organization: 'YouTube',
        href: 'https://youtube.com',
        role: 'Content Creator',
        dates: 'Jul 2021 — Present',
        icon: 'tabler:brand-youtube',
        description:
          'Grew a video-editing channel past 20,000 subscribers, 32M+ impressions and 7M+ views. Launched and ran buyorphic.com, selling editing presets for $500+ in its first year.',
      },
    ]}
  />

  <!-- Projects ********************** -->

  <Projects
    id="projects"
    title="Projects"
    columns={3}
    classes={{ headline: { container: 'max-w-none text-left md:mx-0', title: 'text-3xl md:text-4xl' } }}
    items={[
      {
        title: 'UT Registration Plus',
        description:
          'The Chrome extension UT Austin students use to plan and register for classes. I lead the 6-person team building it.',
        tags: ['TypeScript', 'React', 'Chrome MV3'],
        result: '60,000+ students',
        href: 'https://github.com/Longhorn-Developers/UT-Registration-Plus',
        linkText: 'View on GitHub',
      },
      {
        title: 'ViewTube',
        description:
          'In progress. A Chrome extension surfacing only outlier YouTube videos — ones far outperforming their own channel’s baseline. Scores each against a rolling median of that channel’s <em>prior</em> uploads, so a 2020 video is judged against 2020, not against a channel that has since grown 50×. Local-only: no server, no API key, no account.',
        tags: ['JavaScript', 'Chrome MV3', 'TF-IDF', 'In progress'],
      },
      {
        title: 'Agricultural Weed Detection',
        description:
          'YOLOv8 object-detection pipeline built at Texas A&M, from a 100-image raw dataset to a production-ready model. OpenCV augmentation scaled training data 6×.',
        tags: ['Python', 'YOLOv8', 'OpenCV'],
        result: '80%+ precision & recall',
      },
    ]}
  />

  <!-- Contact *********************** -->

  <CallToAction
    id="contact"
    title="Let's build something"
    subtitle="Open to software engineering internships for Summer 2027."
    actions={[
      {
        variant: 'primary',
        text: 'Email me',
        href: 'mailto:arun.bagavathiannan@gmail.com',
        icon: 'tabler:mail',
      },
      { text: 'GitHub', href: 'https://github.com/arunbagavathiannan', target: '_blank' },
    ]}
  />

  <Fragment slot="footer">
    <Footer
      links={[]}
      secondaryLinks={[]}
      socialLinks={[
        { ariaLabel: 'LinkedIn', icon: 'tabler:brand-linkedin', href: 'https://linkedin.com/in/arun-bagavathiannan' },
        { ariaLabel: 'GitHub', icon: 'tabler:brand-github', href: 'https://github.com/arunbagavathiannan' },
        { ariaLabel: 'Email', icon: 'tabler:mail', href: 'mailto:arun.bagavathiannan@gmail.com' },
      ]}
      footNote="© 2026 Arun Bagavathiannan."
    />
  </Fragment>
</Layout>
