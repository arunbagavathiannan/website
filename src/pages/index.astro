---
import Layout from '~/layouts/PageLayout.astro';

import fujiImage from '~/assets/images/mt-fuji.jpg';

import Header from '~/components/widgets/Header.astro';
import HeroIntro from '~/components/widgets/HeroIntro.astro';
import ExperienceList from '~/components/widgets/ExperienceList.astro';
import Projects from '~/components/widgets/Projects.astro';
import VideoFeature from '~/components/widgets/VideoFeature.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import Footer from '~/components/widgets/Footer.astro';

const metadata = {
  title: 'Arun Bagavathiannan — Software Engineer',
  ignoreTitleTemplate: true,
  description:
    'Computer Science student at UT Austin. Technical Lead on UT Registration Plus, a Chrome extension used by 60,000+ students.',
};
---

<Layout metadata={metadata}>
  <Fragment slot="announcement"></Fragment>

  <Fragment slot="header">
    <Header
      links={[
        { text: 'Experience', href: '#experience' },
        { text: 'Projects', href: '#projects' },
        { text: 'Contact', href: '#contact' },
      ]}
      isSticky
      showToggleTheme
    />
  </Fragment>

  <!-- Hero ************************** -->

  <HeroIntro
    id="about"
    name="Arun Bagavathiannan"
    resume={{ text: 'View Résumé', href: '/resume.pdf' }}
    image={{ src: fujiImage, alt: 'Arun standing above the clouds at dusk', caption: 'captured on Mt. Fuji' }}
    socials={[
      { label: 'LinkedIn', href: 'https://linkedin.com/in/arun-bagavathiannan', icon: 'tabler:brand-linkedin' },
      { label: 'GitHub', href: 'https://github.com/arunbagavathiannan', icon: 'tabler:brand-github' },
      { label: 'Email', href: 'mailto:arun.bagavathiannan@gmail.com', icon: 'tabler:mail' },
      { label: 'YouTube', href: 'https://www.youtube.com/@orphicakm', icon: 'tabler:brand-youtube' },
    ]}
  >
    <Fragment slot="intro">
      <p>
        I'm a Computer Science student at UT Austin. I lead a team of five on{' '}
        <a href="https://github.com/Longhorn-Developers/UT-Registration-Plus" target="_blank" rel="noopener noreferrer"
          >UT Registration Plus</a
        >, the Chrome extension 60,000+ students use to build their schedules. Before that I trained computer-vision
        models for agricultural research at Texas A&amp;M, and I've spent five years growing a{' '}
        <a href="https://www.youtube.com/@orphicakm" target="_blank" rel="noopener noreferrer">YouTube channel</a>{
          ' '
        }past 20,000 subscribers.
      </p>
    </Fragment>
  </HeroIntro>

  <!-- Experience ******************** -->

  <ExperienceList
    id="experience"
    title="Experience"
    classes={{ headline: { container: 'max-w-none text-left md:mx-0', title: 'text-3xl md:text-4xl' } }}
    items={[
      {
        organization: 'Longhorn Developers',
        href: 'https://github.com/Longhorn-Developers',
        role: 'Technical Lead, UT Registration Plus',
        location: 'Austin, TX',
        dates: 'Aug 2026 — Present',
        icon: 'tabler:code',
        description:
          'Promoted from Software Engineer to lead a team of 5. Ran end-to-end hiring for the developer fellowship — screened 80+ applications, interviewed finalists, selected 4 engineers at roughly a 5% acceptance rate.',
      },
      {
        organization: 'Longhorn Developers',
        href: 'https://github.com/Longhorn-Developers',
        role: 'Software Engineer, UT Registration Plus',
        location: 'Austin, TX',
        dates: 'Jan 2026 — Aug 2026',
        icon: 'tabler:brand-chrome',
        description:
          'Built the Course Status Checker for real-time seat tracking inside the calendar UI, cited in UT CS News coverage of the extension. Designed a throttled refresh system in React and TypeScript to avoid API rate-limiting under university infrastructure constraints, and a reactive store synchronising state between background service workers and the frontend.',
      },
      {
        organization: 'YouTube',
        href: 'https://www.youtube.com/@orphicakm',
        role: 'Content Creator',
        dates: 'Jul 2021 — Present',
        icon: 'tabler:brand-youtube',
        description:
          'Grew a video-editing channel past 20,000 subscribers, 32M+ impressions and 7M+ views. Launched and ran buyorphic.com, selling editing presets for $500+ in its first year.',
      },
      {
        organization: 'Texas A&M University',
        role: 'ML Research Intern',
        location: 'College Station, TX',
        dates: 'Jan 2025 — Mar 2025',
        icon: 'tabler:microscope',
        description:
          'Took a raw 100-image dataset to a production YOLOv8 detection model at 80%+ precision and recall. Automated augmentation workflows in Python and OpenCV scaled training data 6×. Presented results at 3 conferences, including the Weed Science Society of America in Vancouver and the European Weed Research Society in Spain.',
      },
    ]}
  />

  <!-- Projects ********************** -->

  <Projects
    id="projects"
    title="Projects"
    columns={2}
    classes={{ headline: { container: 'max-w-none text-left md:mx-0', title: 'text-3xl md:text-4xl' } }}
    items={[
      {
        title: 'Breakout',
        description:
          'A Chrome extension scoring YouTube videos against rolling channel medians, so a video is judged against its own channel’s baseline rather than raw view count. Parses <code>ytInitialData</code> instead of the quota-limited API. A TF-IDF niche filter builds weighted vocabulary from seed channels, surfacing adjacent outliers that keyword search misses.',
        tags: ['JavaScript', 'Chrome MV3', 'TF-IDF'],
      },
      {
        title: 'Investly',
        description:
          'An end-to-end LLM research pipeline in Python: RSS ingestion, local Gemma classification, ChromaDB RAG and autonomous daily paper trading against SPY. Measured news coverage against forward returns (ρ=+0.34, p=0.001 at 3 days, inverting by 1 month), then backtested and rejected the resulting strategy.',
        tags: ['Python', 'Gemma', 'ChromaDB', 'RAG'],
        href: 'https://github.com/arunbagavathiannan/investly',
        linkText: 'View on GitHub',
      },
    ]}
  />

  <!-- Video ************************* -->

  <VideoFeature
    id="video"
    title="On YouTube"
    classes={{ headline: { container: 'max-w-none text-left md:mx-0', title: 'text-3xl md:text-4xl' } }}
    items={[
      {
        id: 'Z25p1DXcPxo',
        playLabel: 'Play: WIS Editing COMPLETE Tutorial',
        align: 'left',
        metrics: [{ value: '76K+', label: 'views' }],
        description:
          'Engineered a step-by-step tutorial to educate tens of thousands of fellow editors to improve their video editing pipeline.',
      },
      {
        id: 'MFCho06kTYI',
        playLabel: 'Play: Explaining How Gojo Lost to Sukuna With Math',
        align: 'right',
        description:
          'Created python scripts for math animations using <a href="https://www.manim.community/" target="_blank" rel="noopener noreferrer">Manim</a>, connecting complex fictional concepts to their mathematical reality.',
      },
    ]}
  />

  <!-- Contact *********************** -->

  <CallToAction
    id="contact"
    title="Let's build something"
    subtitle="Open to software, forward-deployed and product engineering internships for Summer 2027."
    actions={[
      {
        variant: 'primary',
        text: 'Email me',
        href: 'mailto:arun.bagavathiannan@gmail.com',
        icon: 'tabler:mail',
      },
      { text: 'GitHub', href: 'https://github.com/arunbagavathiannan', target: '_blank' },
    ]}
  />

  <Fragment slot="footer">
    <Footer
      links={[]}
      secondaryLinks={[]}
      socialLinks={[
        { ariaLabel: 'LinkedIn', icon: 'tabler:brand-linkedin', href: 'https://linkedin.com/in/arun-bagavathiannan' },
        { ariaLabel: 'GitHub', icon: 'tabler:brand-github', href: 'https://github.com/arunbagavathiannan' },
        { ariaLabel: 'Email', icon: 'tabler:mail', href: 'mailto:arun.bagavathiannan@gmail.com' },
      ]}
      footNote="© 2026 Arun Bagavathiannan."
    />
  </Fragment>
</Layout>
