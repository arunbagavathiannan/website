---
import Layout from '~/layouts/LandingLayout.astro';

import Hero2 from '~/components/widgets/Hero2.astro';
import SocialProof from '~/components/widgets/SocialProof.astro';
import Note from '~/components/widgets/Note.astro';
import Content from '~/components/widgets/Content.astro';
import Pricing from '~/components/widgets/Pricing.astro';
import Bento from '~/components/widgets/Bento.astro';
import Steps2 from '~/components/widgets/Steps2.astro';
import Testimonials from '~/components/widgets/Testimonials.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import Newsletter from '~/components/widgets/Newsletter.astro';

import { getPermalink } from '~/utils/permalinks';

// A subscription landing page sells a relationship, not a purchase: value that
// arrives every month, a price that repeats, and the freedom to leave. So the
// order is value first, plans early, then the reasons people stay. This page is
// one, about itself. Replace the plans and the copy; keep the order.

const metadata = {
  title: 'Subscription Landing Page Example & Guide',
  description:
    'A complete subscription landing page built with AstroWind: recurring value, monthly and yearly plans, cancel-anytime promise, retention features, how it works, proof and FAQ, with notes on why each block converts. Free Astro template.',
  openGraph: { type: 'website' },
};

const faqs = [
  {
    title: 'What makes a subscription landing page different from a pricing page?',
    description:
      'A pricing page compares plans for people who already decided to buy. A subscription landing page has to sell the recurring relationship first: what arrives every month, why it stays valuable, and how easy it is to leave.',
  },
  {
    title: 'Monthly or yearly first?',
    description:
      'Show both, highlight yearly, and state the saving in plain units (“2 months free”), not percentages. Let the monthly price anchor the value before the yearly discount lands.',
  },
  {
    title: 'How prominent should the cancellation policy be?',
    description:
      'As prominent as the price. “Cancel anytime, in one click, from your account” next to the plans removes the main fear of subscribing and costs nothing if you mean it.',
  },
  {
    title: 'Should I offer a free trial or a money-back window?',
    description:
      'One of the two. A trial suits products people need to use to understand; a refund window suits content or services. Either way, say it once, near the price, and honour it without friction.',
  },
  {
    title: 'What keeps subscribers from churning?',
    description:
      'What the retention section below lists: a fast first win, a predictable delivery rhythm, visible new value, a pause option and transparent billing. The landing page should promise only the ones you deliver.',
  },
  {
    title: 'How do I adapt this page with AstroWind?',
    description:
      'Every block is a widget from src/components/widgets (Hero2, Content, Pricing, Features, Steps2, Testimonials, FAQs, CallToAction). Replace the plans in the Pricing widget, point the buttons at your checkout, keep value before price.',
  },
];
---

<Layout metadata={metadata}>
  <!-- 1. Hero: the recurring promise -->

  <Hero2
    tagline="Subscription Landing Demo"
    title="Subscription Landing Page: Turn Casual Browsers into Loyal Subscribers!"
    subtitle="Unlock the formula for a Subscription Landing Page that keeps your audience coming back for more."
    actions={[
      { variant: 'primary', text: 'Call to Action', href: '#plans', icon: 'tabler:square-rounded-arrow-right' },
      { text: 'Learn more', href: '#value' },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1593510987046-1f8fcfc512a0?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=2070&q=80',
      alt: 'Ironic image associated with canceling a subscription. Subscription Landing Page Demo',
    }}
  />

  <!-- Trust strip: the numbers a subscription page can state before the price -->

  <SocialProof
    id="trust"
    items={[
      { value: '4.9/5', label: 'average rating (sample)', icon: 'tabler:star-filled', rating: 5 },
      { value: '12,000+', label: 'active subscribers (sample)', icon: 'tabler:users' },
      { value: 'Cancel anytime', label: 'one click, no call', icon: 'tabler:lock-open' },
      { value: 'MIT', label: 'licensed template', icon: 'tabler:license' },
    ]}
  />

  <Note
    title="Why it works:"
    description="A subscription is a promise repeated every month. The hero states the promise; the next block shows what actually arrives, so the price that follows has something to be compared with."
  />

  <!-- 2. Recurring value: what arrives, and how often -->

  <Content
    id="value"
    tagline="Recurring value"
    title="What subscribers get, every month"
    items={[
      {
        title: 'A delivery with a rhythm',
        description:
          'Say what arrives and when: “a new template pack on the first Monday”. Predictability is what people pay for monthly.',
      },
      {
        title: 'Access that accumulates',
        description:
          'The library, the archive, the community: things that grow while the subscription runs and make leaving cost something.',
      },
      {
        title: 'A first win in the first week',
        description:
          'Describe what a new subscriber achieves before the second charge. If you cannot name it, churn starts there.',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1525909002-1b05e0c869d8?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=1674&q=80',
      alt: 'A person reading on a tablet, receiving a recurring delivery',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">Sell the second month</h3>
      Anyone can sell the first month. Describe the value in a way that still makes sense in month six, and the page will
      attract subscribers who stay instead of ones who try.
    </Fragment>
  </Content>

  <!-- 3. Plans, early: monthly anchors, yearly wins -->

  <Pricing
    id="plans"
    tagline="Plans"
    title="Two ways to pay for the same thing"
    subtitle="Sample plans to show the block: monthly anchors the value, yearly is highlighted with the saving in plain units. Replace with your real prices."
    prices={[
      {
        title: 'Monthly',
        subtitle: 'Sample plan',
        price: 12,
        period: 'per month',
        items: [
          { description: 'Everything in the subscription' },
          { description: 'Billed monthly, cancel anytime' },
          { description: 'The anchor the yearly plan is compared with' },
        ],
        callToAction: { text: 'Start monthly', href: getPermalink('/contact') },
      },
      {
        title: 'Yearly',
        subtitle: 'Sample plan, 2 months free',
        price: 120,
        period: 'per year',
        items: [
          { description: 'Everything in Monthly' },
          { description: 'Two months free compared with paying monthly' },
          { description: 'One charge, one renewal reminder before it' },
          { description: 'Same one-click cancellation' },
        ],
        callToAction: { text: 'Start yearly', href: getPermalink('/contact') },
        hasRibbon: true,
        ribbonTitle: 'best value',
      },
      {
        title: 'Team',
        subtitle: 'Sample plan',
        price: 39,
        period: 'per month',
        items: [
          { description: 'Everything in Yearly, for up to 5 seats' },
          { description: 'Shared library and billing' },
          { description: 'The anchor that makes Yearly feel reasonable' },
        ],
        callToAction: { text: 'Talk to us', href: getPermalink('/contact') },
      },
    ]}
  />

  <Note
    icon="tabler:lock-open"
    title="Cancel anytime:"
    description="One click, from the account page, effective at the end of the paid period, no email to write and no call to make. State your policy this plainly right under the plans."
  />

  <!-- 4. Retention: why people stay -->

  <Bento
    id="retention"
    tagline="Retention"
    title="What makes subscribers stay"
    subtitle="A subscription page should promise the things that reduce churn, and only the ones you deliver. Six that matter."
    items={[
      {
        title: 'A fast first win',
        description:
          'Onboarding that gets the subscriber to the first result in the first session, before the second charge is even close.',
        icon: 'tabler:trophy',
        span: 2,
      },
      {
        title: 'A predictable rhythm',
        description:
          'New value on a schedule people can anticipate. Irregular delivery reads as neglect, even when the total is the same.',
        icon: 'tabler:calendar-repeat',
      },
      {
        title: 'Visible new value',
        description:
          'A changelog, a “new this month” email, a badge in the library. Subscribers should never wonder what they paid for.',
        icon: 'tabler:list-check',
      },
      {
        title: 'A pause option',
        description:
          'Pausing keeps a subscriber who would otherwise cancel. Offer it before the cancel button, not instead of it.',
        icon: 'tabler:player-pause',
      },
      {
        title: 'Transparent billing',
        description:
          'A reminder before every renewal, receipts that explain themselves, no price change without notice.',
        icon: 'tabler:receipt',
      },
      {
        title: 'An exit without friction',
        description:
          'Cancelling in one click is the strongest reason to sign up in the first place. Make it true and say it.',
        icon: 'tabler:lock-open',
        span: 3,
      },
    ]}
  />

  <!-- 5. How it works -->

  <Steps2
    id="how-it-works"
    tagline="How it works"
    title="Subscribe, receive, manage"
    subtitle="Three steps, so the visitor knows what happens after the button and how they stay in control."
    isReversed
    callToAction={{ text: 'See the plans', href: '#plans', variant: 'primary' }}
    items={[
      {
        title: 'Subscribe',
        description:
          'Pick monthly or yearly, pay once, get immediate access. The confirmation email says when the next charge is.',
        icon: 'tabler:number-1',
      },
      {
        title: 'Receive',
        description:
          'New value arrives on the promised rhythm; the library grows; the “new this month” email keeps it visible.',
        icon: 'tabler:number-2',
      },
      {
        title: 'Manage',
        description:
          'Switch plans, pause or cancel from the account page. Every change takes effect at the end of the paid period.',
        icon: 'tabler:number-3',
      },
    ]}
  />

  <!-- 6. Proof: subscribers who stayed -->

  <Testimonials
    id="proof"
    tagline="Proof"
    title="Quotes from people who renewed"
    subtitle="Placeholders on purpose. On a subscription page the best proof is tenure: quotes that mention how long someone has stayed and why."
    testimonials={[
      {
        testimonial: 'A quote that mentions how many months the subscriber has stayed and what keeps them.',
        name: 'Subscriber name',
        job: 'Role, subscriber since month/year (sample testimonial)',
        image: {
          src: 'https://images.unsplash.com/photo-1618835962148-cf177563c6c0?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=930&q=80',
          alt: 'Portrait placeholder for a subscriber testimonial',
        },
      },
      {
        testimonial: 'A quote about the first win: what they got done in the first week.',
        name: 'Subscriber name',
        job: 'Role, subscriber since month/year (sample testimonial)',
        image: {
          src: 'https://images.unsplash.com/photo-1453738773917-9c3eff1db985?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=1320&q=80',
          alt: 'Portrait placeholder for a subscriber testimonial',
        },
      },
      {
        testimonial:
          'A quote from someone who paused and came back. Nothing says “easy to leave” like someone who left and returned.',
        name: 'Subscriber name',
        job: 'Role, subscriber since month/year (sample testimonial)',
        image: {
          src: 'https://images.unsplash.com/photo-1544005313-94ddf0286df2?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=1320&q=80',
          alt: 'Portrait placeholder for a subscriber testimonial',
        },
      },
    ]}
  />

  <!-- 7. Objections, also exposed as FAQPage structured data -->

  <FAQs
    id="faq"
    tagline="FAQ"
    title="Questions people ask before they subscribe"
    subtitle="Billing, cancellation and value questions, answered before checkout. The same answers feed a FAQ rich result in search."
    items={faqs}
    schema
  />

  <!-- 8. Newsletter: the low-commitment alternative to subscribing today -->

  <Newsletter
    id="newsletter"
    tagline="Not ready yet?"
    title="Get the retention checklist by email"
    subtitle="One email with the six practices above as a checklist. No sequence, no follow-ups; the plans will still be here."
    placeholder="you@company.com"
    button="Send it"
    disclaimer="One email, then nothing unless you subscribe. This form is a template: pass an <code>action</code> to connect it to your email tool."
  />

  <!-- 9. Close -->

  <CallToAction
    id="get-template"
    title="Build your subscription page"
    subtitle="This page is part of the free AstroWind template: Astro + Tailwind CSS, every block a reusable widget. Replace the plans, keep value before price."
    actions={[
      {
        variant: 'primary',
        text: 'Get the template',
        href: 'https://github.com/arthelokyo/astrowind',
        target: '_blank',
        icon: 'tabler:download',
      },
      { text: 'Read the guide', href: getPermalink('landing', 'post') },
    ]}
  />
</Layout>
