---
import Layout from '~/layouts/LandingLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Note from '~/components/widgets/Note.astro';
import Content from '~/components/widgets/Content.astro';
import Steps2 from '~/components/widgets/Steps2.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Testimonials from '~/components/widgets/Testimonials.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import FeatureTabs from '~/components/widgets/FeatureTabs.astro';
import Gallery from '~/components/widgets/Gallery.astro';

import { getPermalink } from '~/utils/permalinks';

// A product details landing page presents one product at three depths: what it
// is, what it does, and exactly what you get. The product here is real (this
// template), so the page is both a working example and a guide: each section is
// one a product page needs, and says why. Replace the product; keep the depths.

const repo = 'https://github.com/arthelokyo/astrowind';

const metadata = {
  title: 'Product Details Landing Page Example & Guide',
  description:
    'A complete product details landing page built with AstroWind: overview, key features, specifications, getting started, price and availability, proof and FAQ, with notes on why each block belongs. Free Astro template.',
  openGraph: { type: 'website' },
};

const faqs = [
  {
    title: 'What is a product details landing page?',
    description:
      'A page dedicated to one product or service, structured in layers: a one-line summary, the main benefits, the full specifications, and everything a buyer needs to decide (price, availability, proof, common questions). It replaces the back-and-forth of a sales conversation.',
  },
  {
    title: 'How is it different from a sales page or a click-through page?',
    description:
      'A sales page argues; a click-through page bridges; a product page informs. Its visitor already wants this kind of thing and is comparing. Completeness and clarity convert here, not persuasion.',
  },
  {
    title: 'How much detail is too much?',
    description:
      'None, if it is organised by depth. Keep the top of the page skimmable (overview and key features) and let the specifications carry the detail further down. Nobody leaves because a spec table is long; they leave because the first screen is vague.',
  },
  {
    title: 'Where do price and availability go?',
    description:
      'Near the top for known products, after the features for new ones. Either way, state them plainly on the page itself; a “contact us for pricing” is a form in disguise and costs conversions.',
  },
  {
    title: 'What kind of images does a product page need?',
    description:
      'At least one of the product in use, not only the product on white. Screenshots for software, context shots for physical goods, and a short demo video if the product moves.',
  },
  {
    title: 'How do I adapt this page with AstroWind?',
    description:
      'Every block is a widget from src/components/widgets (Hero, Content, Features, Steps2, Stats, Testimonials, FAQs, CallToAction). Replace the copy and images, keep the three depths, and point the buttons at your store or checkout.',
  },
];
---

<Layout metadata={metadata}>
  <!-- 1. Hero: one product, one line, one action -->

  <Hero
    tagline="Product Details Demo"
    title="Product Landing Page: Showcase with Precision and Passion!"
    subtitle="Step-by-step guide to designing a Landing Page that highlights every facet of your product or service."
    actions={[
      { variant: 'primary', text: 'Call to Action', href: '#get', icon: 'tabler:square-rounded-arrow-right' },
      { text: 'Learn more', href: '#overview' },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1473188588951-666fce8e7c68?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=2174&q=80',
      alt: 'A spotlight on a product. Product Details Landing Page Demo',
    }}
  />

  <Note
    title="Why it works:"
    description="A product page starts with the product in one sentence and one image. The product on this page is real: the AstroWind template. Everything below is what a buyer would want to know about it."
  />

  <!-- 2. Overview: the first depth -->

  <Content
    id="overview"
    tagline="Overview"
    title="What it is, who it is for, what you need"
    items={[
      {
        title: 'What it is',
        description:
          'A free, open-source website template for Astro and Tailwind CSS: pages, widgets, a blog, SEO and image optimisation, ready to customise.',
      },
      {
        title: 'Who it is for',
        description:
          'Developers and small teams who want a fast, well-structured site without designing every section from scratch: startups, SaaS, portfolios, marketing sites, blogs.',
      },
      {
        title: 'What you need',
        description: 'Node.js 22.22 or newer, a code editor and about ten minutes. No account, no licence key.',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1531973486364-5fa64260d75b?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=1674&q=80',
      alt: 'A developer working on a website at a laptop',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">
        Three questions, answered first
      </h3>
      A visitor comparing products wants the summary before the detail. Answer what, who and what-do-I-need in the first screen
      after the hero; the specifications can wait.
    </Fragment>
  </Content>

  <!-- 3. Key features: the second depth -->

  <FeatureTabs
    id="features"
    tagline="Key features"
    title="What it does, in the buyer’s terms"
    subtitle="Pick a feature to see it. Each tab is described by the outcome it produces; the full list lives in the specifications below."
    items={[
      {
        title: '22 ready-made widgets',
        description:
          'Hero, features, steps, pricing, testimonials, FAQ, stats, contact and more. Every page on this site, including this one, is built from them.',
        icon: 'tabler:components',
        image: {
          src: 'https://images.unsplash.com/photo-1519389950473-47ba0277781c?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=2070&q=80',
          alt: 'A team composing pages from ready-made sections',
        },
      },
      {
        title: 'Blog with MDX, categories, tags and RSS',
        description:
          'Write in Markdown, embed components when you need them, and get feeds and taxonomy pages generated at build time.',
        icon: 'tabler:article',
        image: {
          src: 'https://images.unsplash.com/photo-1600132806370-bf17e65e942f?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=2194&q=80',
          alt: 'Blueprint drawings, a stand-in for the blog structure',
        },
      },
      {
        title: 'Dark mode, RTL, SEO and optimised images',
        description:
          'Light and dark themes from CSS variables, right-to-left layouts, metadata and Open Graph images, sitemap and responsive images with no extra setup.',
        icon: 'tabler:moon',
        image: {
          src: 'https://images.unsplash.com/photo-1531973486364-5fa64260d75b?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=1674&q=80',
          alt: 'A developer working on a website at a laptop',
        },
      },
      {
        title: 'Ready for AI coding assistants',
        description:
          'AGENTS.md and step-by-step skills so Claude Code, Codex or Cursor can extend the site reliably, plus shadcn/ui-compatible design tokens.',
        icon: 'tabler:robot',
        image: {
          src: 'https://images.unsplash.com/photo-1552664688-cf412ec27db2?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=1674&q=80',
          alt: 'A team planning work on a whiteboard',
        },
      },
    ]}
  />

  <!-- 4. Specifications: the third depth -->

  <Content
    id="specifications"
    isReversed
    tagline="Specifications"
    title="Exactly what you get"
    items={[
      {
        title: 'Framework',
        description: 'Astro 7.x with the static output; adapters can be added for on-demand pages.',
      },
      {
        title: 'Styling',
        description: 'Tailwind CSS 4 with CSS-first configuration and shadcn/ui-compatible design tokens.',
      },
      {
        title: 'Language and tooling',
        description: 'TypeScript, ESLint and Prettier configured; npm run check runs all three.',
      },
      { title: 'Content', description: 'Markdown and MDX blog posts with a typed schema; six demo posts included.' },
      {
        title: 'Pages',
        description:
          '4 home page demos, 6 landing page demos, about, services, pricing, contact, 404, terms and privacy.',
      },
      {
        title: 'Requirements',
        description: 'Node.js 22.22 or newer. Deploys to any static host; Dockerfile with nginx included.',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1600132806370-bf17e65e942f?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=2194&q=80',
      alt: 'Blueprint drawings on a desk',
    }}
    callToAction={{ text: 'Browse the source on GitHub', href: repo, target: '_blank', icon: 'tabler:brand-github' }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">Specs are where trust is won</h3>
      The buyer who reads this far is deciding. Give them the exact versions, sizes, requirements and contents, in a list
      they can scan and compare.
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- 5. Gallery: let them look at it from every angle -->

  <Gallery
    id="gallery"
    tagline="Gallery"
    title="Show it from every angle"
    subtitle="Buyers zoom in. Six to eight real images, each with a caption that says what they are looking at, answer more questions than a paragraph. Click any image to open it."
    images={[
      {
        src: 'https://images.unsplash.com/photo-1600132806370-bf17e65e942f?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=800&q=80',
        alt: 'Blueprint drawings on a desk',
        caption: 'Specifications, laid out',
      },
      {
        src: 'https://images.unsplash.com/photo-1519389950473-47ba0277781c?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=800&q=80',
        alt: 'Laptops on a table during a meeting',
        caption: 'The team working with the template',
      },
      {
        src: 'https://images.unsplash.com/photo-1516321497487-e288fb19713f?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=800&q=80',
        alt: 'A tidy desk with a laptop and notebook',
        caption: 'Everyday setup',
      },
      {
        src: 'https://images.unsplash.com/photo-1552664688-cf412ec27db2?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=800&q=80',
        alt: 'A team planning on a whiteboard',
        caption: 'Planning a release',
      },
      {
        src: 'https://images.unsplash.com/photo-1559136555-9303baea8ebd?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=800&q=80',
        alt: 'Sticky notes on a glass wall',
        caption: 'Roadmap session',
      },
      {
        src: 'https://images.unsplash.com/photo-1512361436605-a484bdb34b5f?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=800&q=80',
        alt: 'A designer working at a desk',
        caption: 'Design in progress',
      },
    ]}
  />

  <!-- 6. Getting started: what happens after the decision -->

  <Steps2
    id="getting-started"
    tagline="Getting started"
    title="From download to a running site in three steps"
    subtitle="A product page should show the first minutes of ownership. Fewer surprises after the purchase, fewer returns."
    callToAction={{ text: 'Get the template', href: '#get', variant: 'primary' }}
    items={[
      {
        title: 'Create the project',
        description:
          'Run npm create astro@latest -- --template arthelokyo/astrowind, then npm install and npm run dev.',
        icon: 'tabler:number-1',
      },
      {
        title: 'Make it yours',
        description:
          'Set name, URL and metadata in src/config.yaml; colours and fonts in CustomStyles.astro; replace the logo.',
        icon: 'tabler:number-2',
      },
      {
        title: 'Build and deploy',
        description:
          'npm run build produces a static dist/ folder for Vercel, Netlify, Cloudflare, GitHub Pages or your own server.',
        icon: 'tabler:number-3',
      },
    ]}
  />

  <!-- 6. Rules of thumb -->

  <Features2
    id="rules"
    tagline="Rules of thumb"
    title="Constraints that keep a product page honest"
    subtitle="Limits, not results. The numbers about the product itself are in the specifications above."
    columns={4}
    items={[
      {
        title: 'One product per page',
        description: 'A page that sells two things sells neither. Variants are fine; alternatives are not.',
        icon: 'tabler:box',
      },
      {
        title: 'Three depths',
        description: 'Overview, features, specifications. Each answers the questions of a more decided buyer.',
        icon: 'tabler:stack-2',
      },
      {
        title: 'The product in use',
        description: 'At least one real image of it being used, not only rendered. Buyers trust context.',
        icon: 'tabler:photo',
      },
      {
        title: 'The price, on the page',
        description: 'A product page without a price sends the buyer to search for it elsewhere. State it.',
        icon: 'tabler:tag',
      },
    ]}
  />

  <!-- 7. Price and availability -->

  <Note
    variant="success"
    icon="tabler:tag"
    title="Price and availability:"
    description="Free. MIT licence, for personal and commercial projects. Available now from the repository; no sign-up. State yours as plainly as this."
  />

  <!-- 8. Proof -->

  <Testimonials
    id="proof"
    tagline="Proof"
    title="What owners say goes here"
    subtitle="Placeholders on purpose. On a product page, quotes should mention concrete use: what was built, how long it took, what surprised them."
    testimonials={[
      {
        testimonial: 'A quote naming what the customer built with the product and how long it took them.',
        name: 'Customer name',
        job: 'Role, company (sample testimonial)',
        image: {
          src: 'https://images.unsplash.com/photo-1618835962148-cf177563c6c0?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=930&q=80',
          alt: 'Portrait placeholder for a customer testimonial',
        },
      },
      {
        testimonial: 'A quote about a specification that mattered: a requirement met, a limit that was not a problem.',
        name: 'Customer name',
        job: 'Role, company (sample testimonial)',
        image: {
          src: 'https://images.unsplash.com/photo-1453738773917-9c3eff1db985?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=1320&q=80',
          alt: 'Portrait placeholder for a customer testimonial',
        },
      },
      {
        testimonial: 'A short one comparing it with the alternative the customer considered.',
        name: 'Customer name',
        job: 'Role, company (sample testimonial)',
        image: {
          src: 'https://images.unsplash.com/photo-1544005313-94ddf0286df2?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=1320&q=80',
          alt: 'Portrait placeholder for a customer testimonial',
        },
      },
    ]}
  />

  <!-- 9. Objections, also exposed as FAQPage structured data -->

  <FAQs
    id="faq"
    tagline="FAQ"
    title="Questions buyers ask about a product page"
    subtitle="Answered here so nobody has to write in. The same answers feed a FAQ rich result in search."
    items={faqs}
    schema
  />

  <!-- 10. Close -->

  <CallToAction
    id="get"
    title="Get the product this page describes"
    subtitle="This page is part of the free AstroWind template: Astro + Tailwind CSS, every block a reusable widget. Download it, replace the product, keep the three depths."
    actions={[
      { variant: 'primary', text: 'Get the template', href: repo, target: '_blank', icon: 'tabler:download' },
      { text: 'Read the guide', href: getPermalink('landing', 'post') },
    ]}
  />
</Layout>
