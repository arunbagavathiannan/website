---
import Layout from '~/layouts/LandingLayout.astro';

import Hero2 from '~/components/widgets/Hero2.astro';
import Contact from '~/components/widgets/Contact.astro';
import Note from '~/components/widgets/Note.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Timeline from '~/components/widgets/Timeline.astro';
import Countdown from '~/components/widgets/Countdown.astro';
import Stats from '~/components/widgets/Stats.astro';
import Content from '~/components/widgets/Content.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

import { getPermalink } from '~/utils/permalinks';

// A pre-launch (coming soon) page sells one thing before the product exists: a
// reason to leave an email now. So the form comes first, and everything below
// it earns that signup: what is coming, when, why now, and something real to
// look at. This page is one, about itself. Replace the launch; keep the order.

const metadata = {
  title: 'Pre-Launch & Coming Soon Landing Page Example & Guide',
  description:
    'A complete pre-launch landing page built with AstroWind: early signup form, what is coming, launch roadmap, honest launch facts, a real teaser and FAQ, with notes on why each block earns the email. Free Astro template.',
  openGraph: { type: 'website' },
};

const faqs = [
  {
    title: 'What is a pre-launch or coming soon landing page?',
    description:
      'A page published before the product is available. It explains what is coming and collects email addresses from people who want to know when it does. Its success metric is signups, not sales.',
  },
  {
    title: 'What should I offer in exchange for the email?',
    description:
      'Something only early signups get: early access, a launch discount, a founder price, or simply being first in line. Say it in the form’s title, not in the fine print.',
  },
  {
    title: 'Do I need a countdown?',
    description:
      'Only if the date is real and near. A countdown to an unknown date, or one that gets reset, destroys trust. A launch window (“early next quarter”) with a roadmap is more honest and works just as well.',
  },
  {
    title: 'How much of the product should I show?',
    description:
      'Something real: a screenshot, a short clip, a prototype. A page with only adjectives asks people to trust a promise; a page with one real image asks them to trust their eyes.',
  },
  {
    title: 'What do I send to the people who signed up?',
    description:
      'A confirmation right away, then two or three short updates before launch (progress, a behind-the-scenes look, the exact date). Silence between signup and launch is where waitlists die.',
  },
  {
    title: 'How do I adapt this page with AstroWind?',
    description:
      'Every block is a widget from src/components/widgets (Hero2, Contact, Features2, Steps, Stats, Content, FAQs, CallToAction). Connect the form in src/components/ui/Form.astro to your email tool, replace the copy and dates, keep the form at the top.',
  },
];
---

<Layout metadata={metadata}>
  <!-- 1. Hero: the promise, and the ask right below it -->

  <Hero2
    tagline="Pre-launch Demo"
    title="Pre-launch Landing Page: Build the Hype Before the Big Reveal!"
    subtitle="Craft a tantalizing Coming Soon or Pre-Launch Landing Page that leaves visitors eagerly awaiting your launch."
    actions={[
      { variant: 'primary', text: 'Call to Action', href: '#notify', icon: 'tabler:square-rounded-arrow-right' },
      { text: 'Learn more', href: '#coming' },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1558803116-c1b4ac867b31?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=2069&q=80',
      alt: 'Store with a Coming Soon sign. Pre-launch Landing Page',
    }}
  />

  <!-- 2. Countdown: a real date makes the launch concrete -->

  <Countdown
    id="launch"
    tagline="Launch day"
    title="The reveal is scheduled"
    subtitle="A visible date beats a vague “coming soon”: it tells visitors how long they are being asked to wait and gives the email sequence a natural rhythm."
    date="2026-12-01T09:00:00Z"
    expiredText="It launched. From here on, this page becomes the product page."
  />

  <!-- 3. The form, first: this page exists to collect it -->

  <Contact
    id="notify"
    tagline="Early access"
    title="Be first in line when it launches"
    subtitle="One field. You get the launch date before anyone else and the early-access price. Nothing else."
    inputs={[{ type: 'email', name: 'email', label: 'Email', autocomplete: 'email', placeholder: 'you@company.com' }]}
    disclaimer={{
      label: 'Email me about this launch only. I can unsubscribe with one click.',
    }}
    description="This form is a template: connect it to your email tool or to Netlify Forms in src/components/ui/Form.astro."
    button="Notify me at launch"
  />

  <Note
    title="Why it works:"
    description="On a pre-launch page the form is the product. It comes right after the hero, asks for one thing and says exactly what the signup gets. Everything below exists for the visitors who need more before they type."
  />

  <!-- 4. What is coming: three cards -->

  <Features2
    id="coming"
    tagline="What is coming"
    title="Tell them what, when and why now"
    subtitle="A coming-soon page has three facts to deliver. Each card below is one, and says how to state it."
    columns={3}
    items={[
      {
        title: 'What: the product in one sentence',
        description:
          'Name the outcome, not the category. “Publish a fast site in an afternoon” beats “a modern web platform”. If you cannot say it in one line yet, the page is early.',
        icon: 'tabler:rocket',
      },
      {
        title: 'When: a date or an honest window',
        description:
          'A real date if you have one, a window if you do not. Never a countdown you might reset. The roadmap below shows how to make a window feel concrete.',
        icon: 'tabler:calendar-event',
      },
      {
        title: 'Why now: what early signups get',
        description:
          'Early access, a launch price, a say in the roadmap. The reason to sign up today rather than after launch is the whole conversion argument of this page.',
        icon: 'tabler:gift',
      },
    ]}
  />

  <!-- 5. Roadmap: make the window concrete -->

  <Timeline
    id="roadmap"
    tagline="Roadmap"
    title="From this page to launch day"
    subtitle="A dated timeline sets expectations. Each step is a promise the emails will keep."
    items={[
      {
        date: 'Week 0',
        title: 'The waitlist opens',
        description:
          'This page goes live with the form, the three facts above and one real teaser. Signups start counting.',
        icon: 'tabler:bell-ringing',
        highlight: true,
      },
      {
        date: 'Weeks 2 to 6',
        title: 'Progress updates',
        description:
          'Two or three short emails: what shipped, what changed, one behind-the-scenes image. Keep the list warm.',
        icon: 'tabler:mail-fast',
      },
      {
        date: 'Week 8',
        title: 'Early access for the list',
        description:
          'Subscribers get in first, at the price promised on this page. Their feedback shapes the public release.',
        icon: 'tabler:users-group',
      },
      {
        date: 'Launch day',
        title: 'This page becomes the product page',
        description:
          'Same URL, new content: the coming-soon page turns into the product details page so no link goes stale.',
        icon: 'tabler:confetti',
      },
    ]}
  />

  <!-- 5. Launch facts: numbers you can stand behind before launch -->

  <Stats
    id="facts"
    tagline="Launch facts"
    title="Numbers a pre-launch page can state honestly"
    subtitle="Before launch you have no customers and no results. You still have facts: state these instead of inventing traction."
    stats={[
      { title: 'field in the form', amount: '1' },
      { title: 'date or window, stated once', amount: '1' },
      { title: 'updates before launch', amount: '3' },
      { title: 'features promised you cannot show', amount: '0' },
    ]}
  />

  <!-- 6. Something real to look at -->

  <Content
    id="teaser"
    isReversed
    tagline="The teaser"
    title="Show one real thing"
    items={[
      {
        title: 'A screenshot, not a mockup',
        description:
          'Even an unfinished screen is proof that the product exists. Label it as a work in progress if it is.',
      },
      {
        title: 'The people behind it',
        description:
          'A name and a face turn a promise into a commitment. One sentence about why you are building this.',
      },
      {
        title: 'What you will not do',
        description:
          'No spam, no selling the list, no launch that slips silently. Saying it here is what makes the single field above enough.',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1519389950473-47ba0277781c?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=2070&q=80',
      alt: 'A team working on laptops around a table, a stand-in for a real product teaser',
    }}
    callToAction={{ text: 'Join the waitlist', href: '#notify', icon: 'tabler:arrow-up' }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">
        Proof before there are customers
      </h3>
      Testimonials do not exist yet, so this section carries the trust: something real from the product, someone real behind
      it, and a plain statement of what the signup does and does not mean.
    </Fragment>
  </Content>

  <!-- 7. Objections, also exposed as FAQPage structured data -->

  <FAQs
    id="faq"
    tagline="FAQ"
    title="Questions people ask before joining a waitlist"
    subtitle="Short answers. The same answers feed a FAQ rich result in search, which is how a coming-soon page gets found before launch."
    items={faqs}
    schema
  />

  <!-- 8. Close: back to the form -->

  <CallToAction
    id="join"
    title="Build your pre-launch page"
    subtitle="This page is part of the free AstroWind template: Astro + Tailwind CSS, every block a reusable widget. Put the form first, replace the facts, connect your email tool."
    actions={[
      {
        variant: 'primary',
        text: 'Get the template',
        href: 'https://github.com/arthelokyo/astrowind',
        target: '_blank',
        icon: 'tabler:download',
      },
      { text: 'Read the guide', href: getPermalink('landing', 'post') },
    ]}
  />
</Layout>
