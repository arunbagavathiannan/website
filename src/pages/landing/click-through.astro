---
import Layout from '~/layouts/LandingLayout.astro';

import Hero2 from '~/components/widgets/Hero2.astro';
import Note from '~/components/widgets/Note.astro';
import Content from '~/components/widgets/Content.astro';
import Features3 from '~/components/widgets/Features3.astro';
import Steps from '~/components/widgets/Steps.astro';
import Comparison from '~/components/widgets/Comparison.astro';
import Testimonials from '~/components/widgets/Testimonials.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import StickyCTA from '~/components/widgets/StickyCTA.astro';

import { getPermalink } from '~/utils/permalinks';

// A click-through landing page has no form. It warms a visitor up between the
// ad (or email, or post) and the place where the conversion happens, and every
// button leads to that one destination. This page is one, about itself: its
// destination is the template repository. Swap the destination and the copy.

const destination = 'https://github.com/arthelokyo/astrowind';

const metadata = {
  title: 'Click-Through Landing Page Example & Guide',
  description:
    'A complete click-through landing page built with AstroWind: message match, one destination, preview of what comes next, proof and FAQ, with notes on why each block moves the click. Free Astro template.',
  openGraph: { type: 'website' },
};

const faqs = [
  {
    title: 'What is a click-through landing page?',
    description:
      'A page between a campaign and the place where the conversion happens (a checkout, a signup, an app store listing). It has no form of its own; its job is to explain the offer and make the next click an easy decision.',
  },
  {
    title: 'When is a click-through page better than sending traffic straight to the offer?',
    description:
      'When the destination is cold: a checkout that shows a price before explaining value, a signup that asks for a card, a store listing with no room for context. The bridge page supplies the missing context first.',
  },
  {
    title: 'How many buttons should it have, and where should they go?',
    description:
      'As many as you like, as long as they all go to the same place with the same wording. One in the hero, one after the proof and one at the end cover visitors who decide early, in the middle and late.',
  },
  {
    title: 'Should the button open the destination in a new tab?',
    description:
      'Usually not. A click-through page hands the visitor over; opening a new tab leaves the bridge behind them and splits attention. This page opens the repository in a new tab only because the destination is an external site.',
  },
  {
    title: 'How do I measure whether it works?',
    description:
      'Track the click-through rate to the destination and the conversion rate on the destination for visitors who came through the bridge versus those who did not. If the second number does not improve, the bridge is not adding context, only a step.',
  },
  {
    title: 'How do I adapt this page with AstroWind?',
    description:
      'Change the destination constant at the top of src/pages/landing/click-through.astro, replace the copy in each widget and keep the order. Every block is a widget from src/components/widgets; no custom code is involved.',
  },
];
---

<Layout metadata={metadata}>
  <!-- 1. Hero: the promise and the first click to the destination -->

  <Hero2
    tagline="Click-through Demo"
    title="Click-through Landing Page: The Perfect Bridge to Conversion!"
    subtitle="Learn how to design a Click-Through Landing Page that seamlessly guides visitors to your main offer."
    actions={[
      {
        variant: 'primary',
        text: 'Call to Action',
        href: destination,
        target: '_blank',
        icon: 'tabler:square-rounded-arrow-right',
      },
      { text: 'Learn more', href: '#bridge' },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1516321497487-e288fb19713f?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=2070&q=80',
      alt: 'Click-through Landing Page Hero Image',
    }}
  />

  <Note
    title="Why it works:"
    description="A click-through page has no form. Its only job is to make the next click feel obvious, so the primary button already points at the destination, right from the hero."
  />

  <!-- 2. What the page is for -->

  <Content
    id="bridge"
    tagline="The bridge"
    title="A page between the campaign and the offer"
    items={[
      {
        title: 'It restates the promise of the ad',
        description:
          'Visitors arrive with a sentence in their head. The first screen repeats it, so they know they are in the right place.',
      },
      {
        title: 'It adds the context the destination lacks',
        description:
          'A checkout shows a price; a store listing shows screenshots. Neither explains why. The bridge does.',
      },
      {
        title: 'It hands the visitor over, warmed up',
        description: 'By the time they click, the destination only has to confirm what the bridge already made clear.',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1600132806370-bf17e65e942f?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=2194&q=80',
      alt: 'Blueprint drawings, a metaphor for the plan behind a click-through page',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">One direction, no detours</h3>
      Everything on this page points the same way. No menu to wander into, no form to fill, no second offer. The visitor either
      understands and clicks, or scrolls to understand more and then clicks.
    </Fragment>
  </Content>

  <!-- 3. What to put on it -->

  <Features3
    id="anatomy"
    tagline="Anatomy"
    title="What a click-through page needs to carry"
    subtitle="Six things, in roughly this order. Skip the ones your destination already does well."
    columns={3}
    items={[
      {
        title: 'Message match',
        description:
          'The headline uses the words of the ad or email that brought the visitor. Different words feel like a wrong turn.',
        icon: 'tabler:link',
      },
      {
        title: 'The benefit before the mechanics',
        description: 'What changes for the visitor, then how it works. The destination will handle the details.',
        icon: 'tabler:sparkles',
      },
      {
        title: 'A preview of the other side',
        description:
          'Show what happens after the click: a screenshot, the steps, the time it takes. Surprises kill conversions.',
        icon: 'tabler:eye',
      },
      {
        title: 'Proof, briefly',
        description:
          'One or two real quotes or figures. The bridge is short; save the case studies for the destination.',
        icon: 'tabler:shield-check',
      },
      {
        title: 'One destination, repeated',
        description: 'Every button goes to the same URL with the same label. Three placements: hero, after proof, end.',
        icon: 'tabler:arrow-right-circle',
      },
      {
        title: 'Nothing else',
        description: 'No newsletter box, no footer maze, no chat popup. Anything that is not the click is friction.',
        icon: 'tabler:eraser',
      },
    ]}
  />

  <!-- 4. The journey the visitor takes -->

  <Steps
    id="journey"
    tagline="The journey"
    title="From the ad to the conversion in four steps"
    items={[
      {
        title: 'Step 1: <span class="font-medium">The campaign makes a promise</span>',
        description: 'An ad, a post or an email says one thing. The bridge page must say the same thing, louder.',
        icon: 'tabler:speakerphone',
      },
      {
        title: 'Step 2: <span class="font-medium">The bridge explains and reassures</span>',
        description:
          'Benefit, preview, proof. Two or three screens at most; this page is deliberately shorter than a sales page.',
        icon: 'tabler:building-bridge',
      },
      {
        title: 'Step 3: <span class="font-medium">The visitor clicks through</span>',
        description: 'To the checkout, the signup or the store, already knowing what they will find there.',
        icon: 'tabler:click',
      },
      {
        title: 'Step 4: <span class="font-medium">The destination converts</span>',
        description: 'Fewer abandoned carts and signups, because the objections were handled one page earlier.',
        icon: 'tabler:check',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1519389950473-47ba0277781c?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=2070&q=80',
      alt: 'A team working on laptops around a table',
    }}
  />

  <!-- 5. Rules of thumb -->

  <Comparison
    id="rules"
    tagline="Rules of thumb"
    title="What belongs on this page, and what belongs on the next"
    subtitle="A click-through page is a bridge. The table shows what stays on the bridge and what waits on the other side."
    mode="versus"
    firstColumnLabel="Element"
    columns={[{ title: 'Click-through page', highlight: true }, { title: 'Destination page' }]}
    rows={[
      { label: 'Destinations', values: ['1', 'As many as needed'] },
      { label: 'Form fields', values: ['0', 'The signup or checkout'] },
      { label: 'Buttons', description: 'Same label, same URL', values: ['3', 'Depends on the page'] },
      { label: 'Proof', values: ['One or two quotes', 'Case studies, reviews, numbers'] },
      { label: 'Pricing', values: [false, true] },
      { label: 'Full feature list', values: [false, true] },
      { label: 'Screens before the first button', values: ['0', 'Not a concern'] },
    ]}
  />

  <!-- 6. Preview of the destination -->

  <Content
    id="preview"
    isReversed
    tagline="The other side"
    title="What happens after you click"
    items={[
      {
        title: 'Where you land',
        description: 'The AstroWind repository on GitHub: README, demo link, and the “Use this template” button.',
      },
      {
        title: 'How long it takes',
        description:
          'Cloning and running the template takes a few minutes with Node.js installed. No account is needed to download it.',
      },
      {
        title: 'What it costs',
        description: 'Nothing. MIT licence, free for personal and commercial projects.',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1531973486364-5fa64260d75b?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=1674&q=80',
      alt: 'A developer working at a laptop',
    }}
    callToAction={{ text: 'Continue to the template', href: destination, target: '_blank', icon: 'tabler:arrow-right' }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">Remove the surprise</h3>
      Tell the visitor exactly what the destination will ask of them and how long it takes. A click with no unknowns is the
      click people actually make.
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- 7. Proof, briefly -->

  <Testimonials
    id="proof"
    tagline="Proof"
    title="Two sentences from real users are enough here"
    subtitle="Placeholders on purpose. A bridge page needs less proof than a sales page: one or two real, specific quotes."
    testimonials={[
      {
        testimonial: 'A quote that confirms the promise of the ad and mentions what the destination was like.',
        rating: 5,
        name: 'Customer name',
        job: 'Role, company (sample testimonial)',
        image: {
          src: 'https://images.unsplash.com/photo-1618835962148-cf177563c6c0?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=930&q=80',
          alt: 'Portrait placeholder for a customer testimonial',
        },
      },
      {
        testimonial: 'A short one about how long the whole thing took, from click to done.',
        rating: 5,
        name: 'Customer name',
        job: 'Role, company (sample testimonial)',
        image: {
          src: 'https://images.unsplash.com/photo-1453738773917-9c3eff1db985?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=1320&q=80',
          alt: 'Portrait placeholder for a customer testimonial',
        },
      },
      {
        testimonial: 'A quote that addresses the reason someone would hesitate to click: price, commitment or time.',
        rating: 5,
        name: 'Customer name',
        job: 'Role, company (sample testimonial)',
        image: {
          src: 'https://images.unsplash.com/photo-1544005313-94ddf0286df2?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=1320&q=80',
          alt: 'Portrait placeholder for a customer testimonial',
        },
      },
    ]}
  />

  <!-- 8. Objections, also exposed as FAQPage structured data -->

  <FAQs
    id="faq"
    tagline="FAQ"
    title="Questions people ask before they click"
    subtitle="Short answers: a bridge page should not become a sales page. The same answers feed a FAQ rich result in search."
    items={faqs}
    schema
  />

  <!-- 9. Close: the destination, one more time -->

  <CallToAction
    id="continue"
    layout="banner"
    title="Continue to the template"
    subtitle="This page is part of the free AstroWind template: Astro + Tailwind CSS, every block a reusable widget. The button below is the click this page exists for."
    actions={[
      {
        variant: 'primary',
        text: 'Get the template',
        href: destination,
        target: '_blank',
        icon: 'tabler:arrow-right',
      },
      { text: 'Read the guide', href: getPermalink('landing', 'post') },
    ]}
  />
  <!-- On phones the hero button is long gone; the bar brings the click back once the reader scrolls -->

  <StickyCTA text="Get the template" href={destination} target="_blank" label="One destination, three placements" />
</Layout>
