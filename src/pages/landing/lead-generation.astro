---
import Layout from '~/layouts/LandingLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Note from '~/components/widgets/Note.astro';
import Features from '~/components/widgets/Features.astro';
import Content from '~/components/widgets/Content.astro';
import Steps from '~/components/widgets/Steps.astro';
import Brands from '~/components/widgets/Brands.astro';
import Testimonials from '~/components/widgets/Testimonials.astro';
import Contact from '~/components/widgets/Contact.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

import { getPermalink } from '~/utils/permalinks';

// This page is a working lead generation landing page *and* a guide to building
// one: every section does its job and explains, in passing, why it is there.
// Swap the copy for your offer and keep the structure.

const metadata = {
  title: 'Lead Generation Landing Page Example & Guide',
  description:
    'A complete lead generation landing page built with AstroWind: hero, offer, proof, form and FAQ, with notes on why each section converts. Free Astro template.',
  openGraph: { type: 'website' },
};

const faqs = [
  {
    title: 'What is a lead generation landing page?',
    description:
      'A single page with one goal: exchange something valuable (a guide, a demo, a quote, a trial) for a visitor’s contact details. Unlike a homepage it has no competing navigation and one call to action repeated throughout.',
  },
  {
    title: 'How many form fields should a lead form have?',
    description:
      'As few as your follow-up needs. Name and email are enough for a content download; add company or budget only when sales will actually use them. Every extra required field lowers completion.',
  },
  {
    title: 'Where should the form go: above the fold or at the end?',
    description:
      'Both. Put a short form or a button that jumps to it in the hero for visitors who arrive convinced, and repeat the form after the proof section for those who need the full story first.',
  },
  {
    title: 'What is a good conversion rate for a lead landing page?',
    description:
      'It depends on traffic source and offer. Cold paid traffic often converts in the low single digits; warm email or retargeting traffic can reach 10–20 %. Compare against your own baseline and test one change at a time.',
  },
  {
    title: 'How do I make the form actually send submissions with AstroWind?',
    description:
      'The Form component ships without a backend on purpose. Add method="POST" and an action (Netlify Forms, Formspree, Web3Forms or your own endpoint) in src/components/ui/Form.astro. See .agents/skills/configure-contact-form.md in the repository.',
  },
  {
    title: 'Does this page work for GDPR / privacy consent?',
    description:
      'The form includes a consent checkbox linked to the privacy policy. Keep the label explicit about what you will send and how often, and store consent with the lead.',
  },
];
---

<Layout metadata={metadata}>
  <!-- 1. Hero: one promise, one action, no distractions -->

  <Hero
    tagline="Lead Generation Landing Demo"
    title="Effective Lead Generation Landing Page: Unlock the Secrets"
    subtitle="Discover the secrets to creating a Landing Page that turns curious visitors into eager leads. (Your Hero should grab attention instantly. Use a powerful headline that speaks directly to your target audience.)"
    actions={[
      { variant: 'primary', text: 'Call to Action', href: '#lead-form', icon: 'tabler:square-rounded-arrow-right' },
      { text: 'Learn more', href: '#anatomy' },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1597423498219-04418210827d?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=1674&q=80',
      alt: 'Magnet attracting screws. Lead generation landing page demo',
    }}
  />

  <Note
    title="Why it works:"
    description="A hero states the outcome, not the product, and offers a single next step. Everything else on the page exists to remove doubts before that step."
  />

  <!-- 2. Anatomy: what every high-converting lead page contains -->

  <Features
    id="anatomy"
    tagline="Anatomy"
    title="The six sections of a lead generation page"
    subtitle="Order matters less than presence: visitors scan, then read. Each block answers a question they have not asked yet."
    columns={2}
    items={[
      {
        title: '1. A promise in the headline',
        description:
          'Say what the visitor gets, in their words. “Get the checklist” beats “Download our PDF”. Keep the subtitle for the how and the who.',
        icon: 'tabler:target-arrow',
      },
      {
        title: '2. The offer, made concrete',
        description:
          'Describe the lead magnet as a thing with a shape: pages, minutes, steps. Vague value (“insights”) does not earn an email address.',
        icon: 'tabler:gift',
      },
      {
        title: '3. Proof someone else trusted you',
        description:
          'Logos, numbers or quotes. One real sentence from a customer outperforms three generic ones. Never invent them.',
        icon: 'tabler:shield-check',
      },
      {
        title: '4. The form, short and visible',
        description:
          'Ask only for what your follow-up needs. Explain what happens after submit. Make the button describe the outcome, not the action.',
        icon: 'tabler:forms',
      },
      {
        title: '5. Objections answered',
        description:
          'An FAQ handles the last doubts (price, privacy, time, fit) without a sales call, and doubles as structured data for search engines.',
        icon: 'tabler:message-question',
      },
      {
        title: '6. A final, repeated call to action',
        description:
          'Visitors who scrolled to the end are the most convinced. Give them the same action again, not a different one.',
        icon: 'tabler:arrow-big-down-lines',
      },
    ]}
  />

  <!-- 3. The offer: make the lead magnet tangible -->

  <Content
    id="offer"
    isReversed
    tagline="The offer"
    title="What you get for your email"
    items={[
      {
        title: 'A one-page checklist',
        description: 'The six sections above, with the questions to ask yourself for each one before you publish.',
      },
      {
        title: 'Copy formulas that survive contact with real users',
        description: 'Headline, subtitle and button patterns you can fill in for any offer.',
      },
      {
        title: 'A measurement plan',
        description: 'Which events to track, what a meaningful test looks like, and when to stop testing.',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1519389950473-47ba0277781c?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=2070&q=80',
      alt: 'A team reviewing a landing page layout on laptops around a table',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">Specific beats impressive</h3>
      A lead magnet is a promise with a shape. Name the format, the length and the outcome, and the form below stops feeling
      like a trade and starts feeling like a shortcut.
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- 4. How it works: the flow behind the page -->

  <Steps
    id="flow"
    tagline="The flow"
    title="From click to conversation in four steps"
    items={[
      {
        title: 'Step 1: <span class="font-medium">Attract with one message</span>',
        description:
          'Every ad, post or email that points here says the same thing as the headline. Message match is the cheapest conversion lift available.',
        icon: 'tabler:speakerphone',
      },
      {
        title: 'Step 2: <span class="font-medium">Remove friction</span>',
        description:
          'No menu, no footer full of links, a page that loads in under two seconds on mobile. This page keeps only a logo and one button in the header.',
        icon: 'tabler:route',
      },
      {
        title: 'Step 3: <span class="font-medium">Capture the minimum</span>',
        description:
          'Two fields and a consent box. Progressive profiling can ask for more later, once the lead has a reason to answer.',
        icon: 'tabler:mail-plus',
      },
      {
        title: 'Step 4: <span class="font-medium">Deliver instantly, follow up deliberately</span>',
        description:
          'Send the asset in the confirmation email, then a short sequence that earns the reply. The landing page’s job ended at submit; the sequence’s job starts there.',
        icon: 'tabler:check',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1600132806370-bf17e65e942f?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=2194&q=80',
      alt: 'Blueprint drawings on a desk, a metaphor for planning the conversion flow',
    }}
  />

  <!-- 5. Numbers: benchmarks a visitor can check against their own page -->

  <Brands
    id="trusted"
    tagline="Trust"
    title="Logos answer “who else uses this?” in one glance"
    subtitle="Real customer logos, with permission, go here. If you have none yet, show partners, press or certifications instead. Never invent them."
    grayscale
    boxed={false}
    icons={[]}
    images={[
      { src: 'https://cdn.pixabay.com/photo/2015/05/26/09/37/paypal-784404_1280.png', alt: 'Paypal' },
      { src: 'https://cdn.pixabay.com/photo/2021/12/06/13/48/visa-6850402_1280.png', alt: 'Visa' },
      { src: 'https://cdn.pixabay.com/photo/2013/10/01/10/29/ebay-189064_1280.png', alt: 'Ebay' },
      { src: 'https://cdn.pixabay.com/photo/2015/04/13/17/45/icon-720944_1280.png', alt: 'Youtube' },
      { src: 'https://cdn.pixabay.com/photo/2013/02/12/09/07/microsoft-80658_1280.png', alt: 'Microsoft' },
    ]}
  />

  <!-- 6. Social proof: where real quotes go -->

  <Testimonials
    id="proof"
    tagline="Social proof"
    title="This is where real customer words go"
    subtitle="Placeholders below, on purpose: never publish invented testimonials. Ask three customers for one sentence each and use their real name, role and photo with permission."
    testimonials={[
      {
        testimonial:
          'One sentence that names the problem the customer had before and the result after. Specific numbers make it credible.',
        name: 'Customer name',
        job: 'Role, company (sample testimonial)',
        image: {
          src: 'https://images.unsplash.com/photo-1618835962148-cf177563c6c0?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=930&q=80',
          alt: 'Portrait placeholder for a customer testimonial',
        },
      },
      {
        testimonial:
          'A quote that addresses the biggest objection your FAQ also answers: time to value, price, or trust.',
        name: 'Customer name',
        job: 'Role, company (sample testimonial)',
        image: {
          src: 'https://images.unsplash.com/photo-1453738773917-9c3eff1db985?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=1320&q=80',
          alt: 'Portrait placeholder for a customer testimonial',
        },
      },
      {
        testimonial:
          'A short one. Variety in length reads as authentic; three quotes of identical shape read as written by the same person.',
        name: 'Customer name',
        job: 'Role, company (sample testimonial)',
        image: {
          src: 'https://images.unsplash.com/photo-1544005313-94ddf0286df2?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=1320&q=80',
          alt: 'Portrait placeholder for a customer testimonial',
        },
      },
    ]}
  />

  <!-- 7. The form: short, explained, with consent -->

  <Contact
    id="lead-form"
    tagline="Get the checklist"
    title="Two fields, one email, no sequence you did not ask for"
    subtitle="You will receive the landing page checklist right away. Nothing else unless you say so."
    inputs={[
      { type: 'text', name: 'name', label: 'Name', autocomplete: 'name', placeholder: 'Your first name is enough' },
      { type: 'email', name: 'email', label: 'Email', autocomplete: 'email', placeholder: 'you@company.com' },
    ]}
    disclaimer={{
      label:
        'I agree to receive the checklist by email and I have read the privacy policy. You can unsubscribe with one click.',
    }}
    description="This form is a template: connect it to Netlify Forms, Formspree or your own endpoint in src/components/ui/Form.astro."
    button="Send me the checklist"
  />

  <!-- 8. FAQ: objections, also exposed as FAQPage structured data -->

  <FAQs
    id="faq"
    tagline="FAQ"
    title="Questions people ask before they fill in a form"
    subtitle="Answering them here saves a sales call and gives search engines a rich result."
    items={faqs}
    schema
  />

  <!-- 9. Final CTA: the same action, one more time -->

  <CallToAction
    id="get-template"
    title="Build your own lead generation page"
    subtitle="This page is part of the free AstroWind template: Astro + Tailwind CSS, every section a reusable widget. Copy it, replace the copy, connect the form."
    actions={[
      {
        variant: 'primary',
        text: 'Get the template',
        href: 'https://github.com/arthelokyo/astrowind',
        target: '_blank',
        icon: 'tabler:download',
      },
      { text: 'Read the guide', href: getPermalink('landing', 'post') },
    ]}
  />
</Layout>
