---
import Layout from '~/layouts/LandingLayout.astro';

import Hero2 from '~/components/widgets/Hero2.astro';
import Note from '~/components/widgets/Note.astro';
import Content from '~/components/widgets/Content.astro';
import Features from '~/components/widgets/Features.astro';
import Steps2 from '~/components/widgets/Steps2.astro';
import Stats from '~/components/widgets/Stats.astro';
import Pricing from '~/components/widgets/Pricing.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import Quote from '~/components/widgets/Quote.astro';

import { getPermalink } from '~/utils/permalinks';

// A long-form sales page that sells one thing: the long-form sales page itself,
// as a method. Every block is in the order a persuasive page uses (problem,
// solution, benefits, process, proof, offer, guarantee, objections, close) and
// says why it sits there. Replace the copy with your product; keep the order.

const metadata = {
  title: 'Long-Form Sales Landing Page Example & Guide',
  description:
    'A complete long-form sales landing page built with AstroWind: problem, solution, benefits, proof, offer, guarantee and FAQ, with notes on why each block sells. Free Astro template.',
  openGraph: { type: 'website' },
};

const faqs = [
  {
    title: 'When should a landing page be long instead of short?',
    description:
      'When the decision is expensive, unfamiliar or emotional: a course, a service, a considered purchase. Short pages work for offers people already understand. Length is not the goal; answering every question before it is asked is.',
  },
  {
    title: 'Does anyone read a page this long?',
    description:
      'Buyers do, and skimmers scan the headlines. That is why every section here has a title that carries the argument on its own. Read only the H2s and you still get the pitch.',
  },
  {
    title: 'How many calls to action should a sales page have?',
    description:
      'One offer, repeated. This page asks for the same action after the hero, after the proof and at the end. Different offers on one page split attention and lower conversion.',
  },
  {
    title: 'Where do price and guarantee go?',
    description:
      'After the value is clear and the proof has landed. Price before benefits feels expensive; a guarantee right after the price removes the last excuse to wait.',
  },
  {
    title: 'How do I adapt this page to my product with AstroWind?',
    description:
      'Every block is a widget in src/components/widgets (Hero, Content, Features, Steps2, Stats, Testimonials, Pricing, FAQs, CallToAction). Keep the order, replace the copy and images, wire the buttons to your checkout or form.',
  },
  {
    title: 'Are the numbers and testimonials on this page real?',
    description:
      'The numbers are constraints, not results, and the testimonials are labelled placeholders. Use only real customer quotes and measured results on your own page; invented proof is the fastest way to lose the sale.',
  },
];
---

<Layout metadata={metadata}>
  <!-- 1. Hero: the big promise and the first ask -->

  <Hero2
    tagline="Long-form Sales Demo"
    title="Long-form Sales: Sell with a Story: The Long-form Way!"
    subtitle="Dive deep into crafting a Landing Page that narrates, persuades, and converts."
    actions={[
      { variant: 'primary', text: 'Call to Action', href: '#offer', icon: 'tabler:square-rounded-arrow-right' },
      { text: 'Learn more', href: '#problem' },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1621452773781-0f992fd1f5cb?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=1626&q=80',
      alt: 'Children telling a story. Long-form Sales Landing Page demo',
    }}
  />

  <Note
    title="Why it works:"
    description="A sales headline promises a transformation, not a feature. The subtitle tells the reader what the page will do for them if they keep scrolling."
  />

  <!-- 2. The problem, in the reader's words -->

  <Content
    id="problem"
    tagline="The problem"
    title="Traffic that reads the headline and leaves"
    items={[
      {
        title: 'Short pages assume the visitor already wants it',
        description:
          'They do not. For anything unfamiliar or expensive, a two-paragraph page leaves every doubt intact.',
      },
      {
        title: 'Features lists do not change minds',
        description:
          'A list tells what the product has. It never says what the visitor’s week looks like after buying.',
      },
      {
        title: 'The sales call carries the whole weight',
        description:
          'When the page does not persuade, a human has to, one conversation at a time. That does not scale.',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1521517407911-565264e7d82d?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=1674&q=80',
      alt: 'A person alone at a desk, thinking, in front of a laptop',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">Name the pain before the cure</h3>
      A reader who recognises their own situation in the first screen keeps reading. Describe the problem precisely and without
      exaggeration; the credibility you earn here pays for every claim below.
    </Fragment>
  </Content>

  <!-- 3. The solution, introduced as a shift -->

  <Content
    id="solution"
    isReversed
    tagline="The solution"
    title="One page that makes the whole argument, in order"
    items={[
      {
        title: 'Problem, then mechanism, then proof',
        description: 'The order matters more than the length. Each block answers the question the previous one raised.',
      },
      {
        title: 'Headlines that read as a summary',
        description: 'Skimmers get the pitch from the H2s alone; readers get the detail underneath.',
      },
      {
        title: 'One offer, repeated at the right moments',
        description: 'After the promise, after the proof and at the end. Same action, same wording.',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1552664688-cf412ec27db2?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=1674&q=80',
      alt: 'A team drawing a plan on a whiteboard',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">Sell the mechanism</h3>
      Explain why the solution works, not only that it works. A reader who understands the mechanism trusts the result and
      stops looking for the catch.
    </Fragment>
  </Content>

  <!-- 4. Benefits: what changes for the buyer -->

  <Features
    id="benefits"
    tagline="Benefits"
    title="What the buyer gets, stated as outcomes"
    subtitle="Each benefit below is written the way a customer would describe it to a colleague, not the way a spec sheet would."
    columns={3}
    items={[
      {
        title: 'Fewer sales calls that start from zero',
        description: 'Prospects arrive having read the argument. The call confirms; it does not convince.',
        icon: 'tabler:phone-off',
      },
      {
        title: 'Objections handled at 3 a.m.',
        description: 'Price, time, fit and risk are answered on the page, in the order they come up.',
        icon: 'tabler:moon-stars',
      },
      {
        title: 'A structure you can measure',
        description:
          'Scroll depth per section tells you where the argument loses people. Fix that block, not the whole page.',
        icon: 'tabler:chart-arrows-vertical',
      },
      {
        title: 'Copy that survives redesigns',
        description: 'The order and the headlines carry the sale; visuals can change without rewriting the pitch.',
        icon: 'tabler:layout-grid',
      },
      {
        title: 'Reusable for every offer',
        description: 'The same nine blocks fit a course, a service or a product. Only the copy changes.',
        icon: 'tabler:copy',
      },
      {
        title: 'Built with widgets you already have',
        description: 'On AstroWind this page is nine components from src/components/widgets. No custom code.',
        icon: 'tabler:components',
      },
    ]}
  />

  <!-- 5. How it works: the process, numbered -->

  <Steps2
    id="process"
    tagline="How it works"
    title="Nine blocks, one direction"
    subtitle="The reading order of this page. Each step is a section you are scrolling past right now."
    callToAction={{ text: 'Jump to the offer', href: '#offer', variant: 'primary' }}
    items={[
      {
        title: 'Promise, problem, solution',
        description: 'The hero makes the promise; the next two blocks name the pain and introduce the mechanism.',
        icon: 'tabler:number-1',
      },
      {
        title: 'Benefits, process, proof',
        description:
          'Outcomes in the buyer’s words, the steps that produce them, and evidence that they happened before.',
        icon: 'tabler:number-2',
      },
      {
        title: 'Offer, guarantee, objections, close',
        description:
          'Price only once value is clear; a guarantee right after; the FAQ for what is left; the same ask one last time.',
        icon: 'tabler:number-3',
      },
    ]}
  />

  <!-- 6. Proof: constraints and (placeholder) testimonials -->

  <Stats
    id="rules"
    tagline="Rules of thumb"
    title="Constraints that keep a sales page honest"
    subtitle="Limits, not results. Real results belong in your testimonials and case studies."
    stats={[
      { title: 'offer per page', amount: '1' },
      { title: 'times the same call to action', amount: '3' },
      { title: 'headlines that read as a summary', amount: '9' },
      { title: 'invented testimonials', amount: '0' },
    ]}
  />

  <Quote
    id="proof"
    quote="One sentence that names the problem the customer had before and the measurable result after. This is a sample: replace it with a real customer’s words, with permission."
    name="Customer name"
    job="Role, company (sample testimonial)"
    rating={5}
    image={{
      src: 'https://images.unsplash.com/photo-1618835962148-cf177563c6c0?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=930&q=80',
      alt: 'Portrait placeholder for a customer testimonial',
    }}
  />

  <!-- 7. The offer: price after value, one highlighted choice -->

  <Pricing
    id="offer"
    tagline="The offer"
    title="Price arrives only now, after the value is clear"
    subtitle="Sample plans to show the block: three options, one visibly recommended, the same button on each. Replace with your real offer."
    prices={[
      {
        title: 'Starter',
        subtitle: 'Sample plan',
        price: 29,
        period: 'per month',
        items: [
          { description: 'The core outcome, stated plainly' },
          { description: 'What is included, no jargon' },
          { description: 'A limit that makes the next plan make sense' },
        ],
        callToAction: { text: 'Choose Starter', href: getPermalink('/contact') },
      },
      {
        title: 'Professional',
        subtitle: 'Sample plan, highlighted',
        price: 79,
        period: 'per month',
        items: [
          { description: 'Everything in Starter' },
          { description: 'The benefit most buyers actually want' },
          { description: 'The reason this is the recommended choice' },
          { description: 'A guarantee or support line' },
        ],
        callToAction: { text: 'Choose Professional', href: getPermalink('/contact') },
        hasRibbon: true,
        ribbonTitle: 'recommended',
      },
      {
        title: 'Team',
        subtitle: 'Sample plan',
        price: 199,
        period: 'per month',
        items: [
          { description: 'Everything in Professional' },
          { description: 'Seats, roles or volume' },
          { description: 'An anchor that makes Professional feel reasonable' },
        ],
        callToAction: { text: 'Talk to us', href: getPermalink('/contact') },
      },
    ]}
  />

  <!-- 8. Guarantee: risk reversal right after the price -->

  <Note
    title="Guarantee:"
    description="Right after the price, remove the last risk: a refund window, a free trial or a clear cancellation policy. Say it in one sentence and mean it."
  />

  <!-- 9. Objections, also exposed as FAQPage structured data -->

  <FAQs
    id="faq"
    tagline="FAQ"
    title="The questions that stop people from buying"
    subtitle="Answered here so the page, not a salesperson, handles them. The same answers feed a FAQ rich result in search."
    items={faqs}
    schema
  />

  <!-- 10. Close: the same ask, one last time -->

  <CallToAction
    id="get-template"
    title="Build your long-form sales page"
    subtitle="This page is part of the free AstroWind template: Astro + Tailwind CSS, every block a reusable widget. Copy it, keep the order, replace the copy."
    actions={[
      {
        variant: 'primary',
        text: 'Get the template',
        href: 'https://github.com/arthelokyo/astrowind',
        target: '_blank',
        icon: 'tabler:download',
      },
      { text: 'Read the guide', href: getPermalink('landing', 'post') },
    ]}
  />
</Layout>
