---
import { Icon } from 'astro-icon/components';
import Image from '~/components/common/Image.astro';
import Headline from '~/components/ui/Headline.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import type { ExperienceList as Props } from '~/types';

// Roles as a plain divided list rather than a timeline: logo and organisation
// on the left, dates and location on the right, description underneath. Reads
// like a résumé, which is what a recruiter is already scanning for.

const {
  title = await Astro.slots.render('title'),
  subtitle = await Astro.slots.render('subtitle'),
  tagline = await Astro.slots.render('tagline'),
  items = [],

  id,
  isDark = false,
  classes = {},
  bg = await Astro.slots.render('bg'),
} = Astro.props;
---

<WidgetWrapper id={id} isDark={isDark} containerClass={`max-w-5xl mx-auto ${classes?.container ?? ''}`} bg={bg}>
  <Headline title={title} subtitle={subtitle} tagline={tagline} classes={classes?.headline as Record<string, string>} />

  <ol class="list-none">
    {
      items.map(({ organization, href, role, location, dates, description, logo, icon }) => (
        <li class="border-t border-black/10 py-8 first:border-t-0 first:pt-0 dark:border-white/10 intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade">
          <div class="flex gap-4 md:gap-5">
            {(logo || icon) && (
              <div class="hidden h-12 w-12 shrink-0 items-center justify-center overflow-hidden rounded-lg bg-black/5 sm:flex dark:bg-white/10">
                {logo ? (
                  <Image src={logo} alt="" class="h-full w-full object-cover" width={48} height={48} loading="lazy" />
                ) : (
                  <Icon name={icon} class="h-6 w-6 text-primary" />
                )}
              </div>
            )}

            <div class="min-w-0 flex-1">
              <div class="flex flex-col gap-x-6 gap-y-1 md:flex-row md:items-baseline md:justify-between">
                <h3 class="text-xl font-bold leading-tight text-heading">
                  {href ? (
                    <a
                      class="group inline-flex items-center gap-1 underline decoration-from-font underline-offset-4 transition hover:text-primary"
                      href={href}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      {organization}
                      <Icon
                        name="tabler:arrow-up-right"
                        class="h-4 w-4 transition-transform group-hover:-translate-y-0.5 group-hover:translate-x-0.5"
                      />
                    </a>
                  ) : (
                    organization
                  )}
                </h3>
                {dates && <p class="shrink-0 font-mono text-sm text-muted md:text-right">{dates}</p>}
              </div>

              <div class="mt-1 flex flex-col gap-x-6 gap-y-1 md:flex-row md:items-baseline md:justify-between">
                {role && <p class="font-medium text-default">{role}</p>}
                {location && <p class="shrink-0 text-sm text-muted md:text-right">{location}</p>}
              </div>

              {description && <p class="mt-3 leading-relaxed text-muted" set:html={description} />}
            </div>
          </div>
        </li>
      ))
    }
  </ol>
</WidgetWrapper>
