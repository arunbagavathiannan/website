---
import { Icon } from 'astro-icon/components';
import Image from '~/components/common/Image.astro';
import Headline from '~/components/ui/Headline.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import type { ExperienceList as Props } from '~/types';

// Roles as a résumé timeline: a round logo on the left with a rule running
// down to the next entry, the organisation and its location across the top,
// then each role with its dates in the accent colour and a plain paragraph in
// full-strength body text. Several roles at one organisation stack under a
// single heading.

const {
  title = await Astro.slots.render('title'),
  subtitle = await Astro.slots.render('subtitle'),
  tagline = await Astro.slots.render('tagline'),
  items = [],

  id,
  isDark = false,
  classes = {},
  bg = await Astro.slots.render('bg'),
} = Astro.props;
---

<WidgetWrapper id={id} isDark={isDark} containerClass={`max-w-5xl mx-auto ${classes?.container ?? ''}`} bg={bg}>
  <Headline title={title} subtitle={subtitle} tagline={tagline} classes={classes?.headline as Record<string, string>} />

  <ol class="list-none">
    {
      items.map(({ organization, href, role, location, dates, description, roles, logo, icon, logoScale }) => {
        const entries = roles?.length ? roles : [{ title: role, dates, description }];
        return (
          <li class="flex gap-4 md:gap-6">
            <div class="flex shrink-0 flex-col items-center">
              <div class="flex h-12 w-12 items-center justify-center overflow-hidden rounded-full bg-white ring-4 ring-white md:h-14 md:w-14 dark:ring-white">
                {logo ? (
                  <Image
                    src={logo}
                    alt=""
                    class="h-full w-full object-contain"
                    style={logoScale ? `transform: scale(${logoScale})` : undefined}
                    width={112}
                    height={112}
                    loading="lazy"
                  />
                ) : (
                  icon && <Icon name={icon} class="h-6 w-6 text-primary" />
                )}
              </div>
              <div class="my-3 w-0.5 flex-1 bg-black/15 dark:bg-white/35" aria-hidden="true" />
            </div>

            <div class="min-w-0 flex-1 pb-8">
              <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
                <h3 class="text-xl font-semibold leading-tight text-heading md:text-2xl">
                  {href ? (
                    <a
                      class="group inline-flex items-center gap-1.5 transition hover:text-primary"
                      href={href}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      {organization}
                      <Icon
                        name="tabler:arrow-up-right"
                        class="h-5 w-5 transition-transform group-hover:-translate-y-0.5 group-hover:translate-x-0.5"
                      />
                    </a>
                  ) : (
                    organization
                  )}
                </h3>
                {location && (
                  <p class="inline-flex shrink-0 items-center gap-1 text-sm text-default">
                    <Icon name="tabler:map-pin" class="h-4 w-4" />
                    {location}
                  </p>
                )}
              </div>

              {entries.map((entry, i) => (
                <div class:list={[i > 0 ? 'mt-5' : 'mt-2']}>
                  {entry.title && (
                    <p class="text-lg leading-tight font-medium text-default md:text-xl">{entry.title}</p>
                  )}
                  {entry.dates && <p class="mt-2 text-sm leading-tight font-semibold text-primary">{entry.dates}</p>}
                  {entry.description && (
                    <p
                      class="mt-2 text-[1.0625rem] leading-relaxed text-default md:text-[1.1rem]"
                      set:html={entry.description}
                    />
                  )}
                </div>
              ))}
            </div>
          </li>
        );
      })
    }
  </ol>
</WidgetWrapper>
