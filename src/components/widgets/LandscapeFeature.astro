---
import Image from '~/components/common/Image.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';

interface Props {
  id?: string;
  src: string;
  alt: string;
  caption: string;
}

const { id, src, alt, caption } = Astro.props;
---

<WidgetWrapper id={id} containerClass="max-w-6xl mx-auto py-10 md:py-14 lg:py-16">
  <figure>
    <figcaption class="mb-3 text-right text-sm text-muted">{caption}</figcaption>
    <div class="landscape-image mx-auto max-w-5xl overflow-hidden">
      <Image
        class="block h-auto w-full object-contain"
        src={src}
        alt={alt}
        width={1364}
        height={768}
        layout="full-width"
        format="webp"
        loading="lazy"
      />
    </div>
  </figure>
</WidgetWrapper>

<style>
  .landscape-image {
    -webkit-mask-image: linear-gradient(to bottom, transparent 0%, #000 14%, #000 86%, transparent 100%);
    mask-image: linear-gradient(to bottom, transparent 0%, #000 14%, #000 86%, transparent 100%);
  }
</style>