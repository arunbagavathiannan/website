---
import { Icon } from 'astro-icon/components';
import Image from '~/components/common/Image.astro';
import Button from '~/components/ui/Button.astro';
import Headline from '~/components/ui/Headline.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import { getColumnsClass } from '~/utils/utils';
import type { Projects as Props } from '~/types';

// Cards for a portfolio, a list of case studies or "our work": image, tags,
// title, short description, an optional measurable result and a link.

const {
  title = await Astro.slots.render('title'),
  subtitle = await Astro.slots.render('subtitle'),
  tagline = await Astro.slots.render('tagline'),
  items = [],
  columns = 3,
  callToAction,

  id,
  isDark = false,
  classes = {},
  bg = await Astro.slots.render('bg'),
} = Astro.props;

const columnsClass = getColumnsClass(columns, '');

// Each skill keeps one tint everywhere it appears, so a tag is recognisable at a
// glance. Keys are lowercase; unlisted tags fall back to the neutral pill.
const TAG_COLORS: Record<string, string> = {
  javascript: 'bg-yellow-400/15 text-yellow-700 dark:text-yellow-300',
  typescript: 'bg-blue-500/15 text-blue-700 dark:text-blue-300',
  react: 'bg-cyan-400/15 text-cyan-700 dark:text-cyan-300',
  'claude api': 'bg-rose-400/15 text-rose-700 dark:text-rose-300',
  rag: 'bg-violet-400/15 text-violet-700 dark:text-violet-300',
  'chrome mv3': 'bg-emerald-400/15 text-emerald-700 dark:text-emerald-300',
  'tf-idf': 'bg-pink-400/15 text-pink-700 dark:text-pink-300',
};
const tagClass = (tag: string) => TAG_COLORS[tag.toLowerCase()] ?? 'bg-black/5 text-muted dark:bg-white/10';
---

<WidgetWrapper id={id} isDark={isDark} containerClass={`max-w-6xl mx-auto ${classes?.container ?? ''}`} bg={bg}>
  <Headline title={title} subtitle={subtitle} tagline={tagline} classes={classes?.headline as Record<string, string>} />

  <ul class:list={['grid gap-6 md:gap-8 list-none', columnsClass]}>
    {
      items.map(({ title: itemTitle, description, image, tags, href, result, linkText, brand }, index) => {
        const Card = href ? 'a' : 'div';
        // In a two-column grid, an odd last card sits centred on its own row
        // instead of hugging the left edge.
        const centerLast = columns === 2 && items.length % 2 === 1 && index === items.length - 1;
        return (
          <li
            class:list={[
              centerLast &&
                'sm:col-span-2 sm:w-[calc((100%-1.5rem)/2)] sm:justify-self-center md:w-[calc((100%-2rem)/2)]',
            ]}
          >
            <Card
              href={href}
              class:list={[
                'group relative flex h-full flex-col overflow-hidden rounded-2xl border border-black/10 bg-white dark:border-white/10 dark:bg-white/[0.03] shadow-sm',
                'transition hover:-translate-y-0.5 hover:shadow-lg',
                brand ? 'hover:border-(--brand)' : 'hover:border-primary',
              ]}
              style={brand ? `--brand: ${brand.color}; --brand-to: ${brand.colorTo ?? brand.color}` : undefined}
            >
              {brand && <div class="project-glow pointer-events-none absolute inset-0" aria-hidden="true" />}
              {image &&
                (typeof image === 'string' ? (
                  <Fragment set:html={image} />
                ) : (
                  <div class="overflow-hidden">
                    <Image
                      class="aspect-[16/10] w-full object-cover transition group-hover:scale-[1.03]"
                      widths={[400, 640]}
                      sizes="(max-width: 639px) 100vw, (max-width: 1023px) 50vw, 400px"
                      width={400}
                      height={250}
                      layout="cover"
                      format="webp"
                      alt={itemTitle ?? ''}
                      {...image}
                    />
                  </div>
                ))}
              <div class="relative flex flex-1 flex-col p-6">
                {(brand || (tags && tags.length > 0)) && (
                  <div class="mb-4 flex items-center gap-3">
                    {brand?.logo ? (
                      <span class="project-logo-image h-11 w-11 shrink-0 overflow-hidden rounded-xl dark:ring-1 dark:ring-white/15">
                        <Image src={brand.logo} alt="" class="h-full w-full" width={88} height={88} loading="lazy" />
                      </span>
                    ) : (
                      brand?.icon && (
                        <span class="project-logo flex h-11 w-11 shrink-0 items-center justify-center rounded-xl text-white">
                          <Icon name={brand.icon} class="h-6 w-6" />
                        </span>
                      )
                    )}
                    {tags && tags.length > 0 && (
                      <ul class="flex flex-wrap gap-1.5 list-none">
                        {tags.map((tag) => (
                          <li class:list={['rounded-full px-2.5 py-0.5 text-xs font-medium', tagClass(tag)]}>{tag}</li>
                        ))}
                      </ul>
                    )}
                  </div>
                )}
                {itemTitle && <h3 class="text-xl font-bold text-heading">{itemTitle}</h3>}
                {description && (
                  <p
                    class="mt-2 text-base leading-relaxed text-default text-pretty md:text-[1.0625rem]"
                    set:html={description}
                  />
                )}
                {result && (
                  <p class="mt-4 inline-flex items-center gap-1.5 text-sm font-semibold text-primary">
                    <Icon name="tabler:trending-up" class="h-4 w-4" />
                    {result}
                  </p>
                )}
                {href && (
                  <span class="mt-auto inline-flex items-center gap-1 pt-4 text-sm font-medium text-primary">
                    {linkText ?? 'View project'}
                    <Icon
                      name="tabler:arrow-right"
                      class="h-4 w-4 transition group-hover:translate-x-0.5 rtl:rotate-180"
                    />
                  </span>
                )}
              </div>
            </Card>
          </li>
        );
      })
    }
  </ul>
  {
    callToAction && (
      <div class="mt-8 flex justify-center md:mt-12">
        <Button {...callToAction} />
      </div>
    )
  }
</WidgetWrapper>

<style>
  /* Per-project identity: a gradient logo tile and a soft glow in the card's
     corner, both from the project's own colours (set as --brand / --brand-to). */
  .project-logo {
    background: linear-gradient(135deg, var(--brand-to), var(--brand));
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 25%),
      0 8px 18px -8px var(--brand);
  }
  .project-logo-image {
    box-shadow: 0 8px 18px -8px var(--brand);
  }
  /* The glow is a radial gradient over the whole card, anchored in the top-right
     corner. At rest it is a faint tint tucked into that corner; on hover it
     spreads across the card while thinning out. It always reaches full
     transparency by the farthest corner, so however far it spreads it fades
     out rather than being cut off by the card's edge. Spread and strength are
     registered properties so the gradient itself animates. */
  @property --glow-spread {
    syntax: '<percentage>';
    inherits: false;
    initial-value: 40%;
  }
  @property --glow-strength {
    syntax: '<percentage>';
    inherits: false;
    initial-value: 26%;
  }
  .project-glow {
    --glow-spread: 40%;
    --glow-strength: 26%;
    background: radial-gradient(
      circle farthest-corner at 100% 0%,
      color-mix(in srgb, var(--brand) var(--glow-strength), transparent) 0%,
      color-mix(in srgb, var(--brand) calc(var(--glow-strength) * 0.55), transparent) calc(var(--glow-spread) * 0.35),
      color-mix(in srgb, var(--brand) calc(var(--glow-strength) * 0.2), transparent) calc(var(--glow-spread) * 0.7),
      transparent var(--glow-spread)
    );
    transition:
      --glow-spread 0.8s cubic-bezier(0.22, 0.61, 0.36, 1),
      --glow-strength 0.8s cubic-bezier(0.22, 0.61, 0.36, 1);
  }
  .group:hover .project-glow {
    --glow-spread: 100%;
    --glow-strength: 18%;
  }
  :global(.dark) .project-glow {
    --glow-strength: 24%;
  }
  :global(.dark) .group:hover .project-glow {
    --glow-strength: 15%;
  }
  @media (prefers-reduced-motion: reduce) {
    .project-glow {
      transition: none;
    }
  }
</style>
