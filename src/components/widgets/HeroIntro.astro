---
import { Icon } from 'astro-icon/components';
import HeroScene from '~/components/widgets/HeroScene.astro';
import type { HeroIntro as Props } from '~/types';

// Editorial hero: a serif name, a prose introduction carrying its own inline
// links, the résumé button in the same glass as the floating nav and a row of
// socials, with the isometric scene (see HeroScene.astro) held to the right
// where a portrait would sit. The paragraph does the work a Hero's CTA row
// usually does, so the claims stay in sentences instead of being broken into
// chrome.
//
// The name sets the width of the text column: the wrapper shrinks to fit the
// (unwrapping) name, and the paragraph and action row take that width without
// widening it (w-0 min-w-full), so the paragraph's right edge lines up with
// the end of the name. On phones the paragraph takes the full width instead.
//
// A burnt-orange rule, faded at both ends like the connector lines between
// sections, separates the text from the scene at `md` and up.
//
// It reserves the whole first screen with the content centred in it, so
// whatever follows starts below the fold. The header floats over the top
// (fixed), so the top padding clears it. svh rather than vh is the height with
// mobile browser chrome showing, which is what is actually visible on load.
//
// Unlike the other widgets this one reveals on first paint rather than on
// scroll: it is already above the fold, so an intersection-driven fade would
// either fire instantly or, worse, never.

const {
  name = await Astro.slots.render('name'),
  intro = await Astro.slots.render('intro'),
  resume,
  socials = [],

  id,
  classes = {},
} = Astro.props;
---

<section {...id ? { id } : {}} class:list={['hero relative not-prose scroll-mt-[4.5rem]', classes?.container]}>
  <div class="mx-auto flex min-h-[100svh] max-w-7xl flex-col justify-center px-4 pt-28 pb-16 md:px-6 md:pt-32 md:pb-20">
    <div
      class="flex flex-col gap-10 md:grid md:grid-cols-[minmax(0,1fr)_auto_minmax(0,1fr)] md:items-center md:gap-8 lg:gap-12 xl:gap-20"
    >
      <div>
        <div class="max-w-full md:w-fit">
          {
            name && (
              <h1
                class="hero-fade-up font-serif text-[clamp(2.5rem,11.5vw,3.5rem)] md:text-[clamp(2.75rem,5.8vw,4.65rem)] leading-[1] font-normal tracking-tight whitespace-nowrap text-heading"
                set:html={name}
              />
            )
          }

          {
            intro && (
              <div
                class="hero-fade-up prose-hero mt-6 text-base md:w-0 md:min-w-full leading-relaxed text-pretty text-default md:text-lg md:leading-relaxed"
                style="--fade-delay: 0.15s"
                set:html={intro}
              />
            )
          }

          {
            (resume || socials.length > 0) && (
              <div
                class="hero-fade-up mt-9 flex flex-wrap md:w-0 md:min-w-full items-center gap-x-6 gap-y-4"
                style="--fade-delay: 0.3s"
              >
                {resume && (
                  <a
                    class="hero-glass group inline-flex items-center gap-1.5 rounded-full px-6 py-3 text-sm font-medium text-heading transition hover:text-primary focus:outline-none focus-visible:ring-2 focus-visible:ring-primary"
                    href={resume.href}
                    target={resume.href?.startsWith('http') ? '_blank' : undefined}
                    rel={resume.href?.startsWith('http') ? 'noopener noreferrer' : undefined}
                  >
                    {resume.text ?? 'View Résumé'}
                    <Icon
                      name={resume.icon ?? 'tabler:arrow-up-right'}
                      class="h-4 w-4 transition-transform group-hover:-translate-y-0.5 group-hover:translate-x-0.5"
                    />
                  </a>
                )}

                {socials.length > 0 && (
                  <ul class="flex items-center gap-1 list-none">
                    {socials.map(({ label, href, icon }) => (
                      <li>
                        <a
                          class="flex h-11 w-11 items-center justify-center rounded-full text-heading transition hover:text-primary focus:outline-none focus-visible:ring-2 focus-visible:ring-primary"
                          href={href}
                          aria-label={label}
                          target={href?.startsWith('http') ? '_blank' : undefined}
                          rel={href?.startsWith('http') ? 'noopener noreferrer' : undefined}
                        >
                          <Icon name={icon} class="h-6 w-6" />
                        </a>
                      </li>
                    ))}
                  </ul>
                )}
              </div>
            )
          }
        </div>
      </div>

      <div class="hero-divider hidden w-0.5 self-stretch md:block" aria-hidden="true"></div>

      <div class="hero-portrait order-first md:order-none">
        <HeroScene />
      </div>
    </div>
  </div>
</section>

<style>
  /* Same glass as the floating nav pill in Header.astro. */
  .hero {
    --hero-glass: rgb(0 0 0 / 4%);
    --hero-glass-hover: rgb(0 0 0 / 8%);
    --hero-glass-border: rgb(0 0 0 / 10%);
  }
  :global(.dark) .hero {
    --hero-glass: rgb(255 255 255 / 5%);
    --hero-glass-hover: rgb(255 255 255 / 10%);
    --hero-glass-border: rgb(255 255 255 / 10%);
  }
  .hero-glass {
    background-color: var(--hero-glass);
    border: 1px solid var(--hero-glass-border);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
  }
  .hero-glass:hover {
    background-color: var(--hero-glass-hover);
  }

  /* Inline links inside the intro paragraph are the navigation device of this
     hero, so they need to read as links without the paragraph turning blue. */
  .prose-hero :global(a) {
    color: var(--aw-color-text-heading);
    text-decoration: underline;
    text-decoration-thickness: from-font;
    text-underline-offset: 0.25em;
    font-weight: 500;
    transition: color 0.15s ease-in;
  }
  .prose-hero :global(a:hover) {
    color: var(--aw-color-primary);
  }
  .prose-hero :global(p + p) {
    margin-top: 1.25rem;
  }

  .hero-divider {
    background: linear-gradient(to bottom, transparent, #bf5700 22%, #bf5700 78%, transparent);
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero-divider {
      animation: heroDivider 1.1s cubic-bezier(0.22, 0.61, 0.36, 1) 0.35s both;
    }
    @keyframes heroDivider {
      from {
        transform: scaleY(0);
      }
      to {
        transform: scaleY(1);
      }
    }

    .hero-fade-up {
      animation: heroFadeUp 1s cubic-bezier(0.22, 0.61, 0.36, 1) both;
      animation-delay: var(--fade-delay, 0s);
    }

    @keyframes heroFadeUp {
      from {
        opacity: 0;
        filter: blur(12px);
        transform: translate3d(0, 1.25rem, 0);
      }
      to {
        opacity: 1;
        filter: blur(0);
        transform: translate3d(0, 0, 0);
      }
    }
  }
</style>
