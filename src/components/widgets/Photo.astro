---
import Image from '~/components/common/Image.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import type { Photo as Props } from '~/types';

// A single photograph used as a breath between sections. Deliberately carries
// the same treatment as the hero portrait: rounded corners, a soft shadow, and
// a top edge that dissolves into the page so the caption sitting above it
// reads as part of the same object rather than a label stuck on top.
//
// No aspect ratio is imposed — each photo keeps its own, so a panorama stays a
// panorama instead of being cropped to a standard frame.

const {
  image,
  caption,
  cropBottom = 0,

  id,
  isDark = false,
  classes = {},
  bg = await Astro.slots.render('bg'),
} = Astro.props;

// Cropping is done with an aspect-ratio frame rather than by editing the file,
// so the original stays intact. Needs the imported image's dimensions.
const cropStyle =
  cropBottom > 0 && typeof image.src !== 'string'
    ? `aspect-ratio: ${image.src.width} / ${image.src.height * (1 - cropBottom)}`
    : undefined;
---

<WidgetWrapper
  id={id}
  isDark={isDark}
  containerClass={`max-w-5xl mx-auto py-4 md:py-6 ${classes?.container ?? ''}`}
  bg={bg}
>
  <figure class="intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade">
    {caption && <figcaption class="mb-3 text-right text-sm text-muted">{caption}</figcaption>}
    <div class="photo-shadow">
      <div class="photo-fade w-full overflow-hidden rounded-2xl" style={cropStyle}>
        <Image
          class:list={['w-full', cropStyle && 'h-full object-cover object-top']}
          src={image.src}
          alt={image.alt}
          widths={[640, 960, 1280, 1600]}
          sizes="(max-width: 1023px) 100vw, 1024px"
          layout="full-width"
          format="webp"
          loading="lazy"
        />
      </div>
    </div>
  </figure>
</WidgetWrapper>

<style>
  /* Identical to the hero portrait: the top edge masks out to transparent so
     the page shows through, and the shadow is a drop-shadow rather than a
     box-shadow because drop-shadow follows the alpha channel — it fades away
     with the image instead of drawing a hard edge across the faded part. */
  .photo-fade {
    -webkit-mask-image: linear-gradient(to bottom, transparent 2%, #000 32%, #000 100%);
    mask-image: linear-gradient(to bottom, transparent 2%, #000 32%, #000 100%);
  }
  .photo-shadow {
    filter: drop-shadow(0 18px 36px rgb(0 0 0 / 38%));
  }
</style>
