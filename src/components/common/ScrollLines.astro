---
// Burnt-orange connector lines that draw themselves as you scroll. Each link
// brackets the underside of a `from` element and runs a line down to its `to`
// element: ending beside a heading (`middle`), on an element's top edge
// (`top`), or wrapping it in a box (`box`). A `closed` bracket is fully drawn
// on landing (blurring in with the hero) and its connector waits for the first
// scroll; a box can trail a fading line down to a `next` element. A `bridge`
// skips the bracket entirely: one plain line down the whitespace between two
// sections, dissolving at both ends so it fills the seam without attaching
// itself to either neighbour. A `stem` link grows out of the bottom of an
// existing vertical line instead of a bracket, and waits for the first scroll.
//
// Geometry is measured from the live layout rather than hard-coded, so the
// lines follow the content at any width. Measurement uses offsetTop/offsetLeft,
// which ignore transforms, so a reveal animation mid-flight can't skew a line.
// Hidden below the md breakpoint, where the two-column layouts stack.
//
// Hovering a bracketed element closes its bracket into a full rounded
// rectangle, however far scrolling has drawn it, and leaving restores the
// scroll-drawn state. Instant under reduced motion.

export interface Link {
  from: string;
  to: string;
  end: 'middle' | 'top' | 'box' | 'bridge';
  closed?: boolean;
  next?: string;
  /** `from` is itself a vertical line (the hero's divider): no bracket, the
   *  connector grows out of its lower end once the visitor starts scrolling. */
  stem?: boolean;
}

export interface Props {
  links: Link[];
}

const { links } = Astro.props;
---

<aw-scroll-lines
  class="pointer-events-none absolute inset-0 hidden overflow-hidden md:block"
  aria-hidden="true"
  data-links={JSON.stringify(links)}
>
  <svg class="h-full w-full"><g data-reveal></g></svg>
</aw-scroll-lines>

<style is:global>
  /* Matches the hero's reveal (timing and the figure's 0.26s delay) so a closed
     bracket arrives with the photo it wraps. It lives on a persistent group, so
     rebuilding the paths on resize doesn't replay it. */
  @media (prefers-reduced-motion: no-preference) {
    aw-scroll-lines [data-reveal] {
      animation: lineReveal 0.75s cubic-bezier(0.22, 0.61, 0.36, 1) 0.26s both;
    }
    @keyframes lineReveal {
      from {
        opacity: 0;
        filter: blur(12px);
        transform: translate3d(-1.5rem, 0, 0);
      }
      to {
        opacity: 1;
        filter: blur(0);
        transform: translate3d(0, 0, 0);
      }
    }
  }
</style>

<script>
  const COLOR = '#BF5700';
  const GAP = 18; // space between a bracket/box and the element it wraps
  const RADIUS = 14; // corner rounding
  const ARM_START = 0.6; // bracket arms begin this far down the element
  const FADE = 90; // length of the fade at the loose ends
  const PEN = 0.9; // lines are drawn up to this fraction of the viewport height
  const STEM = 0.76; // a stem connector leaves its line this far down, where it is still solid
  const SVG_NS = 'http://www.w3.org/2000/svg';

  type Point = [number, number];
  type Box = { x: number; y: number; w: number; h: number };
  type Stroke = { el: SVGPathElement; length: number; windows: [number, number, number][] };
  const CLOSE_MS = 550; // how long a bracket takes to close on hover

  // Page position of an element, ignoring transforms.
  function measure(el: HTMLElement): Box {
    let x = 0;
    let y = 0;
    for (let node: HTMLElement | null = el; node; node = node.offsetParent as HTMLElement | null) {
      x += node.offsetLeft;
      y += node.offsetTop;
    }
    return { x, y, w: el.offsetWidth, h: el.offsetHeight };
  }

  // Polyline -> path data with rounded corners.
  function toPath(points: Point[]): string {
    let d = `M${points[0][0]},${points[0][1]}`;
    for (let i = 1; i < points.length - 1; i++) {
      const [px, py] = points[i - 1];
      const [cx, cy] = points[i];
      const [nx, ny] = points[i + 1];
      const r = Math.min(RADIUS, Math.hypot(cx - px, cy - py) / 2, Math.hypot(nx - cx, ny - cy) / 2);
      const ax = cx - Math.sign(cx - px) * r;
      const ay = cy - Math.sign(cy - py) * r;
      const bx = cx + Math.sign(nx - cx) * r;
      const by = cy + Math.sign(ny - cy) * r;
      d += ` L${ax},${ay} Q${cx},${cy} ${bx},${by}`;
    }
    const [lx, ly] = points[points.length - 1];
    return d + ` L${lx},${ly}`;
  }

  class AwScrollLines extends HTMLElement {
    private svg!: SVGSVGElement;
    private strokes: Stroke[] = [];
    private frame = 0;
    private resizeObserver: ResizeObserver | null = null;
    private desktop = window.matchMedia('(min-width: 768px)');
    private reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    private hoverAbort: AbortController | null = null;
    private onScroll = () => this.schedule(false);
    private onLayout = () => this.schedule(true);

    connectedCallback() {
      this.svg = this.querySelector('svg')!;
      this.resizeObserver = new ResizeObserver(this.onLayout);
      this.resizeObserver.observe(this.parentElement ?? document.body);
      window.addEventListener('scroll', this.onScroll, { passive: true });
      this.desktop.addEventListener('change', this.onLayout);
      document.fonts?.ready.then(this.onLayout);
      this.schedule(true);
    }

    disconnectedCallback() {
      this.resizeObserver?.disconnect();
      this.hoverAbort?.abort();
      window.removeEventListener('scroll', this.onScroll);
      this.desktop.removeEventListener('change', this.onLayout);
      cancelAnimationFrame(this.frame);
    }

    private rebuildPending = false;
    private schedule(rebuild: boolean) {
      this.rebuildPending ||= rebuild;
      if (this.frame) return;
      this.frame = requestAnimationFrame(() => {
        this.frame = 0;
        if (this.rebuildPending) this.build();
        this.rebuildPending = false;
        this.draw();
      });
    }

    private build() {
      // Keep the reveal group itself so its animation isn't restarted.
      const reveal = this.svg.querySelector('g[data-reveal]')!;
      reveal.replaceChildren();
      Array.from(this.svg.children).forEach((child) => child !== reveal && child.remove());
      this.strokes = [];
      this.hoverAbort?.abort();
      this.hoverAbort = new AbortController();
      if (!this.desktop.matches) return;

      const origin = measure(this.offsetParent as HTMLElement);
      const links = JSON.parse(this.dataset.links ?? '[]');
      const defs = document.createElementNS(SVG_NS, 'defs');
      this.svg.append(defs);

      type LinkSpec = { from: string; to: string; end: string; closed?: boolean; next?: string; stem?: boolean };
      links.forEach((link: LinkSpec, i: number) => {
        const fromEl = document.querySelector<HTMLElement>(link.from);
        const toEl = document.querySelector<HTMLElement>(link.to);
        if (!fromEl || !toEl) return;
        const from = measure(fromEl);
        const to = measure(toEl);
        // Shift into this overlay's coordinate space.
        from.x -= origin.x;
        from.y -= origin.y;
        to.x -= origin.x;
        to.y -= origin.y;

        // A bridge is only the gap: a line down the middle of the whitespace,
        // faded at both ends, touching neither section. Skipped when the two
        // have closed up, so a collapsed gap gets no stub.
        if (link.end === 'bridge') {
          const x = (from.x + from.w / 2 + to.x + to.w / 2) / 2;
          const top = from.y + from.h;
          const bottom = to.y;
          if (bottom - top > GAP)
            this.addStroke(
              defs,
              `${i}g`,
              [
                [x, top],
                [x, bottom],
              ],
              top,
              'both'
            );
          return;
        }

        // Stem: carry on from an existing line. It leaves the line where the
        // line's own fade has not begun, so the join is seamless, and it only
        // starts drawing once the pen moves past where it sits on page load.
        if (link.stem) {
          if (!from.h) return;
          const sx = from.x + from.w / 2;
          const sy = from.y + from.h * STEM;
          const ex = to.x + to.w / 2;
          const ey = link.end === 'middle' ? to.y + to.h / 2 : to.y - GAP;
          const midY = (sy + ey) / 2;
          const route: Point[] =
            Math.abs(ex - sx) < 2
              ? [
                  [sx, sy],
                  [ex, ey],
                ]
              : [
                  [sx, sy],
                  [sx, midY],
                  [ex, midY],
                  [ex, ey],
                ];
          const start = window.scrollY < 10 ? Math.max(sy, window.innerHeight * PEN - origin.y + 1) : sy;
          this.addStroke(defs, `${i}s`, route, start, 'out');
          return;
        }

        // Bracket: two arms start partway down each side and meet under the middle.
        const armTop = from.y + from.h * ARM_START;
        const bottom = from.y + from.h + GAP;
        const jx = from.x + from.w / 2;
        const armStrokes = this.strokes.length;
        let armEnd = this.addPair(
          defs,
          `${i}a`,
          [
            [from.x - GAP, armTop],
            [from.x - GAP, bottom],
            [jx, bottom],
          ],
          [
            [from.x + from.w + GAP, armTop],
            [from.x + from.w + GAP, bottom],
            [jx, bottom],
          ],
          armTop,
          'in'
        );
        this.addClose(fromEl, from, bottom, jx);

        if (link.closed) {
          // Already complete on landing, so it reveals with the hero instead of drawing.
          this.strokes.slice(armStrokes).forEach((s) => {
            s.windows.forEach((w) => ((w[0] = -2), (w[1] = -1)));
            reveal.append(s.el);
          });
          // The connector starts just past where the pen sits before any scroll.
          armEnd = Math.max(bottom, window.innerHeight * PEN - origin.y + 1);
        }

        // Connector: down to the halfway point, across, then down to the target.
        const ex = to.x + to.w / 2;
        const ey = link.end === 'middle' ? to.y + to.h / 2 : to.y - GAP;
        const midY = (bottom + ey) / 2;
        const route: Point[] =
          Math.abs(ex - jx) < 2
            ? [
                [jx, bottom],
                [ex, ey],
              ]
            : [
                [jx, bottom],
                [jx, midY],
                [ex, midY],
                [ex, ey],
              ];
        const fades = link.end !== 'box';
        const connectorEnd = this.addStroke(defs, `${i}c`, route, armEnd, fades ? 'out' : null);

        if (link.end === 'box') {
          // Box: two halves leave the top centre and close at the bottom centre.
          const left = to.x - GAP;
          const right = to.x + to.w + GAP;
          const boxBottom = to.y + to.h + GAP;
          const boxEnd = this.addPair(
            defs,
            `${i}b`,
            [
              [ex, ey],
              [left, ey],
              [left, boxBottom],
              [ex, boxBottom],
            ],
            [
              [ex, ey],
              [right, ey],
              [right, boxBottom],
              [ex, boxBottom],
            ],
            connectorEnd,
            null
          );

          // Tail: a straight line from the bottom of the box, fading out into `next`.
          const nextEl = link.next ? document.querySelector<HTMLElement>(link.next) : null;
          if (nextEl) {
            const next = measure(nextEl);
            this.addStroke(
              defs,
              `${i}t`,
              [
                [ex, boxBottom],
                [ex, next.y - origin.y],
              ],
              boxEnd,
              'out'
            );
          }
        }
      });
    }

    // Closes a bracket into a full rounded rectangle while its element is
    // hovered, however much of the bracket scrolling has drawn so far. Two
    // halves leave the top centre and sweep down each side to meet at the
    // bottom centre, tracing over whatever is already drawn (and over the arms'
    // faded tops, which read solid while closed). Leaving undraws them back to
    // the top, which uncovers the scroll-drawn state underneath.
    private addClose(el: HTMLElement, box: Box, bottom: number, jx: number) {
      const top = box.y - GAP;
      const halves = [box.x - GAP, box.x + box.w + GAP].map((x) => {
        const path = document.createElementNS(SVG_NS, 'path');
        path.setAttribute(
          'd',
          toPath([
            [jx, top],
            [x, top],
            [x, bottom],
            [jx, bottom],
          ])
        );
        path.setAttribute('fill', 'none');
        path.setAttribute('stroke', COLOR);
        path.setAttribute('stroke-width', '2');
        path.setAttribute('stroke-linecap', 'round');
        this.svg.append(path);
        const length = path.getTotalLength();
        path.style.strokeDasharray = `${length}`;
        path.style.strokeDashoffset = `${length}`;
        path.style.transition = this.reducedMotion.matches
          ? 'none'
          : `stroke-dashoffset ${CLOSE_MS}ms cubic-bezier(0.22, 0.61, 0.36, 1)`;
        return { path, length };
      });

      const set = (closed: boolean) =>
        halves.forEach(({ path, length }) => (path.style.strokeDashoffset = `${closed ? 0 : length}`));

      const { signal } = this.hoverAbort!;
      el.addEventListener('mouseenter', () => set(true), { signal });
      el.addEventListener('mouseleave', () => set(false), { signal });
    }

    // Two mirrored strokes drawn in step; returns where their timeline ends.
    private addPair(defs: SVGDefsElement, id: string, a: Point[], b: Point[], start: number, fade: 'in' | null) {
      this.addStroke(defs, `${id}1`, b, start, fade);
      return this.addStroke(defs, `${id}0`, a, start, fade);
    }

    // Adds one stroke and returns the scroll position at which it finishes.
    // Each segment gets a scroll window: vertical runs track their own height,
    // horizontal runs take a short fixed distance, and every window starts where
    // the previous one ended so the tip never jumps.
    private addStroke(
      defs: SVGDefsElement,
      id: string,
      points: Point[],
      start: number,
      fade: 'in' | 'out' | 'both' | null
    ) {
      const path = document.createElementNS(SVG_NS, 'path');
      path.setAttribute('d', toPath(points));
      path.setAttribute('fill', 'none');
      path.setAttribute('stroke-width', '2');
      path.setAttribute('stroke-linecap', 'round');

      if (fade) {
        // Each mode picks the vertical span the gradient covers and the stops
        // laid along it, as [offset, opacity].
        const ys = points.map((p) => p[1]);
        const top = ys[0];
        const bottom = ys[ys.length - 1];
        let span: [number, number];
        let stops: [number, string][];
        if (fade === 'both') {
          // Two fades on one run, so they are a fraction of it rather than a
          // fixed length: across a short gap they shrink instead of meeting in
          // the middle and rubbing the line out.
          const t = Math.min(FADE / Math.abs(bottom - top), 0.4);
          span = [top, bottom];
          stops = [
            [0, '0'],
            [t, '1'],
            [1 - t, '1'],
            [1, '0'],
          ];
        } else if (fade === 'in') {
          span = [top, top + FADE];
          stops = [
            [0, '0'],
            [1, '1'],
          ];
        } else {
          // Never longer than the final run, or the fade would climb the corner.
          span = [bottom - Math.min(FADE, Math.abs(bottom - ys[ys.length - 2]) * 0.9), bottom];
          stops = [
            [0, '1'],
            [1, '0'],
          ];
        }
        const grad = document.createElementNS(SVG_NS, 'linearGradient');
        grad.id = `aw-line-${id}`;
        grad.setAttribute('gradientUnits', 'userSpaceOnUse');
        grad.setAttribute('x1', '0');
        grad.setAttribute('x2', '0');
        grad.setAttribute('y1', String(span[0]));
        grad.setAttribute('y2', String(span[1]));
        stops.forEach(([offset, opacity]) => {
          const stop = document.createElementNS(SVG_NS, 'stop');
          stop.setAttribute('offset', String(offset));
          stop.setAttribute('stop-color', COLOR);
          stop.setAttribute('stop-opacity', opacity);
          grad.append(stop);
        });
        defs.append(grad);
        path.setAttribute('stroke', `url(#${grad.id})`);
      } else {
        path.setAttribute('stroke', COLOR);
      }
      this.svg.append(path);

      const windows: [number, number, number][] = [];
      let t = start;
      let total = 0;
      for (let i = 1; i < points.length; i++) {
        const [px, py] = points[i - 1];
        const [cx, cy] = points[i];
        const segment = Math.hypot(cx - px, cy - py);
        const end = py === cy ? t + Math.min(Math.max(segment * 0.25, 30), 100) : Math.max(cy, t + 40);
        windows.push([t, end, segment]);
        total += segment;
        t = end;
      }

      // Path length is slightly shorter than the polyline (rounded corners), so
      // scale the windows onto the real length.
      const length = path.getTotalLength();
      windows.forEach((w) => (w[2] *= length / total));
      path.style.strokeDasharray = `${length}`;
      path.style.strokeDashoffset = `${length}`;
      this.strokes.push({ el: path, length, windows });
      return t;
    }

    private draw() {
      if (!this.strokes.length) return;
      const pen = this.reducedMotion.matches
        ? Infinity
        : window.scrollY + window.innerHeight * PEN - measure(this.offsetParent as HTMLElement).y;
      for (const { el, length, windows } of this.strokes) {
        let drawn = 0;
        for (const [from, to, segment] of windows) {
          const progress = Math.min(Math.max((pen - from) / (to - from), 0), 1);
          drawn += progress * segment;
          if (progress < 1) break;
        }
        el.style.strokeDashoffset = `${length - drawn}`;
      }
    }
  }

  if (!customElements.get('aw-scroll-lines')) {
    customElements.define('aw-scroll-lines', AwScrollLines);
  }
</script>
